    { "component": "Butter-Mascarpone-Creme", "amount": "15-20", "unit": "g", "name": "Puderzucker" },
    { "component": "Butter-Mascarpone-Creme", "amount": "85", "unit": "g", "name": "Mascarpone (zimmerwarm)" },
    { "component": "Butter-Mascarpone-Creme", "amount": "3", "unit": "EL", "name": "Zitronensaft" },
