    { "component": "Drip", "amount": "50", "unit": "g", "name": "Sahne" },
    { "component": "Drip", "amount": "", "unit": "", "name": "Lebensmittelfarbe" }
  ],
  "steps": [
    { "component": "Vanille-Wunderkuchen", "text": "Den Ofen auf 160 °C Ober-/Unterhitze vorheizen." },
    { "component": "Vanille-Wunderkuchen", "text": "Den Boden der Backform mit Backpapier auslegen, die Seiten nicht fetten." },
    { "component": "Vanille-Wunderkuchen", "text": "Zucker, Vanillezucker, Eier und Salz ca. 15 Minuten zu einer hellen, luftigen Masse aufschlagen." },
    { "component": "Vanille-Wunderkuchen", "text": "Das Backpulver in das Mehl sieben." },
    { "component": "Vanille-Wunderkuchen", "text": "Öl und Vanillesoße mischen, am Schüsselrand einlaufen lassen und kurz und langsam weiterrühren." },
    { "component": "Vanille-Wunderkuchen", "text": "Die Mehlmischung zusieben und vorsichtig unterheben." },
    { "component": "Vanille-Wunderkuchen", "text": "In die Backform gießen und glattstreichen." },
    { "component": "Vanille-Wunderkuchen", "text": "Ca. 55 Minuten backen, Stäbchenprobe machen." },
    { "component": "Vanille-Wunderkuchen", "text": "10 Minuten in der Form auskühlen lassen, dann mit einem Tafelmesser lösen und stürzen." },

    { "component": "Joghurt-Mascarpone-Creme", "text": "Die Erdbeeren in kleine Würfel schneiden, Himbeeren und Heidelbeeren halbieren." },
    { "component": "Joghurt-Mascarpone-Creme", "text": "Die Früchte in 3 separate Schüsseln geben." },
    { "component": "Joghurt-Mascarpone-Creme", "text": "Sahne mit Sahnefest steif schlagen." },
    { "component": "Joghurt-Mascarpone-Creme", "text": "Mascarpone und Joghurt glatt rühren." },
    { "component": "Joghurt-Mascarpone-Creme", "text": "Vanillezucker, Puderzucker, Zitronenabrieb und San Apart zugeben." },
    { "component": "Joghurt-Mascarpone-Creme", "text": "Die Sahne unterheben." },
    { "component": "Joghurt-Mascarpone-Creme", "text": "Die Creme zu gleichen Teilen auf die drei Beerenschüsseln verteilen und sofort weiterverarbeiten." },

    { "component": "Tortenaufbau", "text": "Den vollständig ausgekühlten Kuchen in 4 gleich dicke Böden teilen." },
    { "component": "Tortenaufbau", "text": "Den hohen Tortenring mit Tortenrandfolie auskleiden." },
    { "component": "Tortenaufbau", "text": "Auf dem ersten Boden die Himbeercreme verteilen und den zweiten Boden auflegen." },
    { "component": "Tortenaufbau", "text": "Auf dem zweiten Boden die Heidelbeercreme verteilen und den dritten Boden auflegen." },
    { "component": "Tortenaufbau", "text": "Auf dem dritten Boden die Erdbeercreme verteilen." },
    { "component": "Tortenaufbau", "text": "Den vierten Boden oben aufsetzen." },
    { "component": "Tortenaufbau", "text": "Mindestens 5 Stunden, idealerweise über Nacht, kalt stellen." },

    { "component": "Butter-Mascarpone-Creme", "text": "Den Mascarpone wie die Butter auf Zimmertemperatur bringen, notfalls kurz in der Mikrowelle." },
    { "component": "Butter-Mascarpone-Creme", "text": "Die Butter mit dem Salz zu einer hellen, luftigen Masse aufschlagen." },
    { "component": "Butter-Mascarpone-Creme", "text": "Den Puderzucker zugeben und weiterschlagen." },
    { "component": "Butter-Mascarpone-Creme", "text": "Zitronensaft und Speisestärke einrühren." },
    { "component": "Butter-Mascarpone-Creme", "text": "Zuletzt den Mascarpone zugeben." },
    { "component": "Butter-Mascarpone-Creme", "text": "Die Creme rosa einfärben und die Torte damit einstreichen." },
    { "component": "Butter-Mascarpone-Creme", "text": "Die übrige Creme dunkler einfärben und für die Deko verwenden." },

    { "component": "Drip", "text": "Die Schokolade klein hacken." },
    { "component": "Drip", "text": "Die Sahne aufkochen." },
    { "component": "Drip", "text": "Den Topf vom Herd nehmen und die Schokolade zugeben, sodass sie komplett mit Sahne bedeckt ist." },
    { "component": "Drip", "text": "Nicht rühren und 5–7 Minuten stehen lassen." },
    { "component": "Drip", "text": "Glattrühren und einfärben." },
    { "component": "Drip", "text": "Auf der gekühlten Torte dekorieren." }
  ],
  "notes": ""
}
