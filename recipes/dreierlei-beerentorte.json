    { "component": "Joghurt-Mascarpone-Creme", "amount": "1", "unit": "Pck.", "name": "Vanillezucker" },
    { "component": "Joghurt-Mascarpone-Creme", "amount": "10-25", "unit": "g", "name": "Puderzucker" },
    { "component": "Joghurt-Mascarpone-Creme", "amount": "1", "unit": "geh. TL", "name": "Zitronenabrieb" },
    { "component": "Joghurt-Mascarpone-Creme", "amount": "5", "unit": "TL", "name": "San Apart" },
    { "component": "Joghurt-Mascarpone-Creme", "amount": "100", "unit": "g", "name": "Himbeeren" },
    { "component": "Joghurt-Mascarpone-Creme", "amount": "100", "unit": "g", "name": "Heidelbeeren" },
    { "component": "Joghurt-Mascarpone-Creme", "amount": "100", "unit": "g", "name": "Erdbeeren (plus zusätzliche Beeren für die Deko)" },

