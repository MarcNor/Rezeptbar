  "steps": [
    { "component": "Pfirsich-Maracuja Kompott", "text": "Frische Pfirsiche überbrühen, die Haut abziehen und das Fruchtfleisch in Würfel schneiden." },
    { "component": "Pfirsich-Maracuja Kompott", "text": "Die Gelatine in eiskaltem Wasser einweichen." },
    { "component": "Pfirsich-Maracuja Kompott", "text": "Das Pektin mit dem Vanillezucker mischen." },
    { "component": "Pfirsich-Maracuja Kompott", "text": "Die Pfirsiche mit Maracujapüree und Zucker leicht erwärmen." },
    { "component": "Pfirsich-Maracuja Kompott", "text": "Die Pektin-Vanillezucker-Mischung einrühren." },
    { "component": "Pfirsich-Maracuja Kompott", "text": "1–2 Minuten kochen lassen." },
    { "component": "Pfirsich-Maracuja Kompott", "text": "Die Gelatine auflösen." },
    { "component": "Pfirsich-Maracuja Kompott", "text": "Das Kompott in die Tortaflex-Form füllen und einfrieren." },

    { "component": "Basilikumcreme", "text": "Die Gelatine einweichen." },
    { "component": "Basilikumcreme", "text": "Schmand, Limettensaft, Limettenabrieb, Zucker und Basilikumblätter mit dem Stabmixer pürieren." },
    { "component": "Basilikumcreme", "text": "Die Zubereitung leicht erwärmen und die Gelatine auflösen." },
    { "component": "Basilikumcreme", "text": "Die Sahne halbsteif schlagen und unterziehen." },
    { "component": "Basilikumcreme", "text": "Die Creme in der Tortaflex-Form auf die gefrorene Fruchtschicht auftragen und einfrieren." },

    { "component": "Biskuit", "text": "Den Backofen auf 180 °C Ober-/Unterhitze vorheizen." },
    { "component": "Biskuit", "text": "Das Eiweiß mit dem Zucker steif schlagen." },
    { "component": "Biskuit", "text": "Das Eigelb sanft einrühren." },
    { "component": "Biskuit", "text": "Mehl und Mandeln darübersieben und zusammen mit dem Limettenabrieb unterheben." },
    { "component": "Biskuit", "text": "Die Masse mit 20 cm ∅ auf Silikonmatte oder Backpapier streichen." },
    { "component": "Biskuit", "text": "10–15 Minuten backen." },
    { "component": "Biskuit", "text": "Abkühlen lassen und auf 18 cm ∅ zuschneiden." },

    { "component": "Pfirsichmousse", "text": "Die Gelatine einweichen." },
    { "component": "Pfirsichmousse", "text": "Die Kuvertüre schmelzen." },
    { "component": "Pfirsichmousse", "text": "Das Pfirsichpüree aufkochen und die Gelatine darin auflösen." },
    { "component": "Pfirsichmousse", "text": "In die geschmolzene Kuvertüre rühren und mit dem Stabmixer aufemulgieren." },
    { "component": "Pfirsichmousse", "text": "Den Joghurt mit dem Zitronensaft glatt rühren und die Pfirsichmasse einrühren." },
    { "component": "Pfirsichmousse", "text": "Die Sahne halbsteif schlagen und unterziehen." },

    { "component": "Aufbau", "text": "Den Biskuit mit Saft oder Sirup bestreichen." },
    { "component": "Aufbau", "text": "Die Dot-Form zu zwei Dritteln mit Mousse füllen." },
    { "component": "Aufbau", "text": "Die gefrorene Frucht-Basilikum-Einlage eindrücken." },
    { "component": "Aufbau", "text": "Die Ränder auffüllen und die Einlage mit einer dünnen Schicht Mousse bedecken." },
    { "component": "Aufbau", "text": "Die Biskuitscheibe auflegen." },
    { "component": "Aufbau", "text": "Über Nacht einfrieren. Optional die Quenelle-Form mit der restlichen Mousse füllen und ebenfalls einfrieren." },

    { "component": "Crumbleboden – Mürbeteig", "text": "Alle Zutaten verkneten." },
    { "component": "Crumbleboden – Mürbeteig", "text": "Den Teig 3–4 mm dick ausrollen." },
    { "component": "Crumbleboden – Mürbeteig", "text": "Bei 180 °C goldbraun backen." },
    { "component": "Crumbleboden – Mürbeteig", "text": "Abkühlen lassen." },

    { "component": "Crumbleboden – Streusel", "text": "Mürbeteig und Waffelröllchen zerbröseln." },
    { "component": "Crumbleboden – Streusel", "text": "Die Kuvertüre mit der Butter schmelzen." },
    { "component": "Crumbleboden – Streusel", "text": "Mit den Streuseln und dem Salz vermischen – am besten mit den Händen." },
    { "component": "Crumbleboden – Streusel", "text": "Den Tortenring (20 cm) mit Tortenrandfolie auslegen." },
    { "component": "Crumbleboden – Streusel", "text": "Die Streusel einfüllen und fest andrücken, dabei auf die Ränder achten." },
    { "component": "Crumbleboden – Streusel", "text": "In den Gefrierschrank stellen." },

    { "component": "Aufschlagganache", "text": "Die Gelatine einweichen." },
    { "component": "Aufschlagganache", "text": "40 g Sahne mit der Glucose aufkochen und über die Kuvertüre gießen." },
    { "component": "Aufschlagganache", "text": "Eine Minute stehen lassen, dann verrühren." },
    { "component": "Aufschlagganache", "text": "Die Gelatine zugeben." },
    { "component": "Aufschlagganache", "text": "Mit dem Stabmixer aufemulgieren und dabei die kalte Sahne zugeben." },
    { "component": "Aufschlagganache", "text": "Mit Frischhaltefolie abdecken und über Nacht kühlen." },

    { "component": "Basilikumsirup", "text": "Zucker und Wasser zu einem Sirup kochen." },
    { "component": "Basilikumsirup", "text": "Die Basilikumblätter blanchieren: kurz in kochendem Wasser garen, durch ein Sieb gießen und in Eiswasser legen." },
    { "component": "Basilikumsirup", "text": "Das blanchierte Basilikum in den Sirup geben und mit dem Stabmixer fein pürieren." },
    { "component": "Basilikumsirup", "text": "Durch ein feines Sieb passieren." },

    { "component": "Basilikumgel", "text": "Agar Agar und Zucker mischen." },
    { "component": "Basilikumgel", "text": "Wasser und Zitronensaft mit der Agar-Zucker-Mischung aufkochen." },
    { "component": "Basilikumgel", "text": "3 Minuten kochen lassen." },
    { "component": "Basilikumgel", "text": "Den Basilikumsirup zugeben." },
    { "component": "Basilikumgel", "text": "Komplett abkühlen lassen." },
    { "component": "Basilikumgel", "text": "Mit dem Stabmixer so lange mixen, bis ein Gel entsteht." },

    { "component": "Mikrowellenbiskuit", "text": "Ei, Zucker, Glucosesirup und Farbe mit dem Mixer schaumig schlagen." },
    { "component": "Mikrowellenbiskuit", "text": "Mehl mit Backpulver darübersieben und unterheben." },
    { "component": "Mikrowellenbiskuit", "text": "Pappbecher zur Hälfte mit der Masse füllen." },
    { "component": "Mikrowellenbiskuit", "text": "Ca. 1 Minute bei 700 Watt in der Mikrowelle garen." },
    { "component": "Mikrowellenbiskuit", "text": "Vorsichtig aus dem Becher lösen und für die Deko zerpflücken." },

    { "component": "Fertigstellung", "text": "Die Torte ausformen und sogleich mit weißem, dann mit grünem Velvetspray besprühen." },
    { "component": "Fertigstellung", "text": "Die Quenelles ebenfalls besprühen und auf die Tortenoberfläche legen." },
    { "component": "Fertigstellung", "text": "Den Crumbleboden auf eine Tortenplatte setzen und den Ring entfernen." },
    { "component": "Fertigstellung", "text": "Den Crumbleboden mit etwas Restmousse bestreichen." },
    { "component": "Fertigstellung", "text": "Die gefrorene Torte mittig aufsetzen." },
    { "component": "Fertigstellung", "text": "Die Aufschlagganache mit dem Mixer steif schlagen – nicht zu stark." },
    { "component": "Fertigstellung", "text": "In einen Spritzbeutel mit Rundtülle füllen und Tupfen spritzen." },
    { "component": "Fertigstellung", "text": "Mit einem Kugelausstecher kleine Mulden in die Tupfen drücken." },
    { "component": "Fertigstellung", "text": "Die Mulden mit Basilikumgel und/oder Gelee füllen." },
    { "component": "Fertigstellung", "text": "Mikrowellenbiskuit und Pfirsichspalten verteilen." },
    { "component": "Fertigstellung", "text": "Mit Basilikumblättern und essbarem Gold dekorieren." },
    { "component": "Fertigstellung", "text": "Die Torte vor dem Servieren auftauen lassen." }
  ],
  "notes": ""
}
