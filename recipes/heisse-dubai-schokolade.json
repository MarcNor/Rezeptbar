    { "component": "Kakao & Schokolade", "amount": "1", "unit": "EL", "name": "Trinkkakao pur" },
    { "component": "Kakao & Schokolade", "amount": "25", "unit": "g", "name": "Zartbitterschokolade (mind. 70 %), gehackt" },

    { "component": "Süßungsmittel & Aromen", "amount": "0,5", "unit": "EL", "name": "brauner Zucker" },
    { "component": "Süßungsmittel & Aromen", "amount": "0,5", "unit": "TL", "name": "Vanilleextrakt" },

    { "component": "Gewürze", "amount": "0,25", "unit": "TL", "name": "Zimt" },
    { "component": "Gewürze", "amount": "1", "unit": "Prise", "name": "Kardamom" },
