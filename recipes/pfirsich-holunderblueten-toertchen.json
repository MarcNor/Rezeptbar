  "steps": [
    { "component": "Pfirsichfüllung", "text": "Pfefferbeeren und Zucker in das Pfirsichpüree geben und kurz aufkochen." },
    { "component": "Pfirsichfüllung", "text": "20 Minuten ziehen lassen." },
    { "component": "Pfirsichfüllung", "text": "Die Gelatine in eiskaltem Wasser einweichen." },
    { "component": "Pfirsichfüllung", "text": "Das Fruchtfleisch in kleine Würfel schneiden." },
    { "component": "Pfirsichfüllung", "text": "Das Püree durch ein Sieb passieren, die Würfel zugeben und erneut erhitzen." },
    { "component": "Pfirsichfüllung", "text": "Die Gelatine auflösen und die Masse auf 8 Mulden der Globe-Form verteilen." },
    { "component": "Pfirsichfüllung", "text": "Mit Folie bedeckt einfrieren." },

    { "component": "Biskuit", "text": "Den Ofen auf 180 °C Umluft vorheizen." },
    { "component": "Biskuit", "text": "Eiweiß, Salz und Zucker zu steifem Eischnee schlagen." },
    { "component": "Biskuit", "text": "Das Eigelb einrühren." },
    { "component": "Biskuit", "text": "Mehl und Himbeerpulver sieben und unterheben." },
    { "component": "Biskuit", "text": "1 EL Teig mit der geschmolzenen Butter verrühren und unterheben." },
    { "component": "Biskuit", "text": "Den Teig als DIN-A4-Rechteck auf Backpapier oder Silikonmatte streichen." },
    { "component": "Biskuit", "text": "Ca. 8–10 Minuten bei 180 °C backen." },
    { "component": "Biskuit", "text": "Abkühlen lassen und Kreise mit ca. 4 cm ∅ ausstechen." },

    { "component": "Pfirsich-Holunderblüten Mousse", "text": "Die Gelatine einweichen." },
    { "component": "Pfirsich-Holunderblüten Mousse", "text": "Pfirsichpüree, Holunderblütensirup und Zucker erhitzen." },
    { "component": "Pfirsich-Holunderblüten Mousse", "text": "Die Gelatine auflösen." },
    { "component": "Pfirsich-Holunderblüten Mousse", "text": "Den Frischkäse einrühren." },
    { "component": "Pfirsich-Holunderblüten Mousse", "text": "Die Schlagsahne halbsteif schlagen und unterheben." },

    { "component": "Mandelkeks", "text": "Die Butter cremig rühren." },
    { "component": "Mandelkeks", "text": "Zucker, Zimt und Salz unterrühren." },
    { "component": "Mandelkeks", "text": "Eigelb und Milch zugeben." },
    { "component": "Mandelkeks", "text": "Mehl und Mandelblättchen zugeben und verkneten." },
    { "component": "Mandelkeks", "text": "Den Teig zu einem Ziegel formen und 1 Stunde kühlen." },
    { "component": "Mandelkeks", "text": "Den Ofen auf 200 °C vorheizen." },
    { "component": "Mandelkeks", "text": "Den Teig 3 mm dick ausrollen." },
    { "component": "Mandelkeks", "text": "Kreise mit ca. 7 cm ∅ ausstechen." },
    { "component": "Mandelkeks", "text": "Ca. 12–13 Minuten backen." },

    { "component": "Aufbau", "text": "Die Stone-Silikonform zu zwei Dritteln mit Mousse füllen." },
    { "component": "Aufbau", "text": "Das gefrorene Pfirsichkompott aus der Globe-Form lösen und in die Mousse drücken." },
    { "component": "Aufbau", "text": "Dünn mit Mousse bestreichen." },
    { "component": "Aufbau", "text": "Einen Biskuitkreis auflegen." },
    { "component": "Aufbau", "text": "Die Lücken mit Mousse füllen und glattstreichen." },
    { "component": "Aufbau", "text": "Mit Folie bedeckt über Nacht einfrieren." },

    { "component": "Pfirsichglasur", "text": "Milch, Sahne, Pfirsichpüree, Zucker und Glucosesirup aufkochen." },
    { "component": "Pfirsichglasur", "text": "Die Kuvertüre zugeben und schmelzen lassen." },
    { "component": "Pfirsichglasur", "text": "Die Gelatine auflösen." },
    { "component": "Pfirsichglasur", "text": "Mit dem Mixstab pürieren." },
    { "component": "Pfirsichglasur", "text": "Mit Lebensmittelfarbe färben." },
    { "component": "Pfirsichglasur", "text": "Die Glasur auf 28 °C temperieren." },

    { "component": "Fertigstellung", "text": "Die gefrorenen Törtchen aus der Form lösen und auf ein Gitter legen." },
    { "component": "Fertigstellung", "text": "Mit der 28 °C warmen Glasur überziehen." },
    { "component": "Fertigstellung", "text": "Die rosa Pfefferbeeren durch ein Sieb über die Törtchen reiben, sodass nur die Schale darauf fällt." },
    { "component": "Fertigstellung", "text": "Komplett auftauen lassen und servieren." }
  ],
