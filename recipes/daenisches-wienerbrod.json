    { "component": "Puddingcreme", "amount": "1", "unit": "", "name": "Vanilleschote" },
    { "component": "Puddingcreme", "amount": "125", "unit": "ml", "name": "Milch (3,5 %)" },

    { "component": "Teig", "amount": "25", "unit": "g", "name": "frische Hefe" },
    { "component": "Teig", "amount": "200", "unit": "ml", "name": "kalte Milch (3,5 %)" },
    { "component": "Teig", "amount": "40", "unit": "g", "name": "Zucker" },
    { "component": "Teig", "amount": "2", "unit": "", "name": "Eier (Gr. L)" },
