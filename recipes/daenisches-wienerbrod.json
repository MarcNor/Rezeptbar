    { "component": "Garnitur", "amount": "1", "unit": "", "name": "Eigelb" },
    { "component": "Garnitur", "amount": "1", "unit": "EL", "name": "Milch (3,5 %)" },
    { "component": "Garnitur", "amount": "60", "unit": "g", "name": "Puderzucker" }
