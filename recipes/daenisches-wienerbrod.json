  "steps": [
    { "component": "Puddingcreme", "text": "Ei, Zucker und Speisestärke mit dem Schneebesen glatt rühren." },
    { "component": "Puddingcreme", "text": "Die Vanilleschote aufschneiden und das Mark auskratzen." },
    { "component": "Puddingcreme", "text": "Schote, Mark, Milch und die Eimischung verquirlen und aufkochen, bis die Masse andickt." },
    { "component": "Puddingcreme", "text": "Die Vanilleschote entfernen und die Creme durch ein feines Sieb streichen." },
    { "component": "Puddingcreme", "text": "Mit Klarsichtfolie abdecken und vollständig abkühlen lassen." },

    { "component": "Teig", "text": "Die Hefe in die Milch bröseln und Zucker, Eier, Salz und die weiche Butter zugeben." },
    { "component": "Teig", "text": "Mit dem Schneebesen verquirlen, das Mehl unterheben und glatt verrühren." },

    { "component": "Formen und Backen", "text": "Den Backofen auf 225 °C Ober-/Unterhitze bzw. 200 °C Umluft vorheizen." },
    { "component": "Formen und Backen", "text": "Den Teig zu einem Rechteck von ca. 60 × 25 cm ausrollen und mittig teilen." },
    { "component": "Formen und Backen", "text": "Je 4 EL Puddingcreme mittig auf den Teigstreifen verteilen." },
    { "component": "Formen und Backen", "text": "Die Teigränder der Länge nach zur Mitte aufrollen." },
    { "component": "Formen und Backen", "text": "Auf ein mit Backpapier belegtes Blech legen." },
    { "component": "Formen und Backen", "text": "Eigelb mit Milch verquirlen und den Teig damit bestreichen." },
    { "component": "Formen und Backen", "text": "Ca. 20 Minuten backen." },

    { "component": "Garnieren", "text": "Den Puderzucker mit 1–1,5 EL Wasser verrühren." },
    { "component": "Garnieren", "text": "In einen Gefrierbeutel füllen und eine kleine Ecke abschneiden." },
    { "component": "Garnieren", "text": "Das Wienerbrød damit verzieren." },
    { "component": "Garnieren", "text": "Auf einem Gitter abkühlen lassen." }
  ],
  "notes": ""
}
