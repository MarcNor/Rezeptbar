  "steps": [
    { "component": "Mangokompott mit Minze", "text": "Die Gelatine in eiskaltem Wasser einweichen." },
    { "component": "Mangokompott mit Minze", "text": "Maracujapüree mit Zucker und Limettenabrieb aufkochen." },
    { "component": "Mangokompott mit Minze", "text": "Die Mangowürfel zugeben und 1–2 Minuten leise köcheln lassen." },
    { "component": "Mangokompott mit Minze", "text": "Die Gelatine ausdrücken und im Kompott auflösen." },
    { "component": "Mangokompott mit Minze", "text": "Die fein gehackte Minze unterrühren." },
    { "component": "Mangokompott mit Minze", "text": "Das Kompott in die Tortaflex-Form füllen und einfrieren, bis es formstabil ist." },

    { "component": "Limetten-Minz Sirup", "text": "Zucker, Limettensaft und Wasser zum Kochen bringen." },
    { "component": "Limetten-Minz Sirup", "text": "Eine Minute köcheln lassen." },
    { "component": "Limetten-Minz Sirup", "text": "Vom Herd nehmen und die Minzblätter einlegen." },
    { "component": "Limetten-Minz Sirup", "text": "Den Sirup im Kühlschrank durchziehen lassen." },

    { "component": "Grüner Rührteig", "text": "Den Backofen auf 180 °C Ober-/Unterhitze vorheizen." },
    { "component": "Grüner Rührteig", "text": "Babyspinat, Schmand, Limettensaft und Limettenabrieb im Blender oder mit dem Stabmixer fein mixen." },
    { "component": "Grüner Rührteig", "text": "Butter und Zucker hellschaumig schlagen." },
    { "component": "Grüner Rührteig", "text": "Die Eier portionsweise zugeben." },
    { "component": "Grüner Rührteig", "text": "Mehl und Backpulver vermischen, darübersieben und kurz verrühren." },
    { "component": "Grüner Rührteig", "text": "Die Spinatmasse untermixen." },
    { "component": "Grüner Rührteig", "text": "Den Teig in die gefettete Springform füllen." },
    { "component": "Grüner Rührteig", "text": "35–40 Minuten backen, Stäbchenprobe machen." },
    { "component": "Grüner Rührteig", "text": "Den Boden auf einem Rost vollständig abkühlen lassen." },
    { "component": "Grüner Rührteig", "text": "Zwei gleichmäßig 1 cm dicke Scheiben schneiden und daraus zwei Kreise mit 16 cm ∅ ausstechen. Tipp: Am Vortag backen, dann lässt sich der Boden besser schneiden." },

    { "component": "Kokosmousse", "text": "Die Gelatine einweichen." },
    { "component": "Kokosmousse", "text": "Kokospüree und Zucker erwärmen." },
    { "component": "Kokosmousse", "text": "Die Gelatine ausdrücken und in der warmen Kokosmasse auflösen." },
    { "component": "Kokosmousse", "text": "Die Sahne halbsteif schlagen und unter die Kokosmasse ziehen." },
    { "component": "Kokosmousse", "text": "Die Mousse kurz in den Kühlschrank stellen, bis sie leicht geliert ist – sie darf nicht zu dünnflüssig sein." },

    { "component": "Aufbau der Einlage", "text": "Die erste Teigscheibe in die Tortaflex-Form legen." },
    { "component": "Aufbau der Einlage", "text": "Die Scheibe mit Limetten-Minz Sirup bepinseln." },
    { "component": "Aufbau der Einlage", "text": "Die Hälfte der Kokosmousse darauf verteilen." },
    { "component": "Aufbau der Einlage", "text": "Das eingefrorene Mangokompott auflegen." },
    { "component": "Aufbau der Einlage", "text": "Mit der restlichen Kokosmousse bestreichen." },
    { "component": "Aufbau der Einlage", "text": "Die zweite Teigscheibe mit Sirup bestreichen und auflegen." },
    { "component": "Aufbau der Einlage", "text": "Die Einlage eine Nacht einfrieren." },

    { "component": "Limettencrunchboden", "text": "Die Kuvertüre schmelzen." },
    { "component": "Limettencrunchboden", "text": "Mit den gemahlenen Cornflakes und dem Limettenabrieb mischen." },
    { "component": "Limettencrunchboden", "text": "Die Masse zwischen zwei Silikonmatten 1–2 mm dünn ausrollen." },
    { "component": "Limettencrunchboden", "text": "Auf einer flachen Platte in den Kühlschrank legen." },
    { "component": "Limettencrunchboden", "text": "Einen Kreis mit 18 cm ∅ ausstechen." },
    { "component": "Limettencrunchboden", "text": "Bis zur Verwendung einfrieren." },

    { "component": "Limettenmousse", "text": "Milch, Zucker und Limettenschale kurz erwärmen und 5 Minuten ziehen lassen." },
    { "component": "Limettenmousse", "text": "Die Gelatine einweichen und die Kuvertüre schmelzen." },
    { "component": "Limettenmousse", "text": "Die Milch erneut erhitzen." },
    { "component": "Limettenmousse", "text": "Die Gelatine ausdrücken und in der Milch auflösen." },
    { "component": "Limettenmousse", "text": "Die Milch durch ein Sieb zur Kuvertüre geben." },
    { "component": "Limettenmousse", "text": "Mit dem Stabmixer durchmixen." },
    { "component": "Limettenmousse", "text": "Den Limettensaft portionsweise zugeben." },
    { "component": "Limettenmousse", "text": "Die Sahne halbsteif schlagen und unterziehen. Die Mousse sofort verwenden." },

    { "component": "Aufbau der Torte", "text": "Die Limettenmousse bis auf einen kleinen Rest in die Pavoni-Form füllen." },
    { "component": "Aufbau der Torte", "text": "Die Mousse an den Seitenwänden hochstreichen." },
    { "component": "Aufbau der Torte", "text": "Die gefrorene Einlage ausformen und in die Mousse drücken." },
    { "component": "Aufbau der Torte", "text": "Mit der restlichen Mousse bestreichen." },
    { "component": "Aufbau der Torte", "text": "Den Limettencrunchboden auflegen." },
    { "component": "Aufbau der Torte", "text": "Mit Folie bedeckt mindestens eine Nacht einfrieren." },

    { "component": "Fertigstellung", "text": "Die Torte aus der Form lösen." },
    { "component": "Fertigstellung", "text": "Sie in gefrorenem Zustand mit grünem Velvetspray besprühen." },
    { "component": "Fertigstellung", "text": "6 Stunden bei Raumtemperatur oder über Nacht im Kühlschrank auftauen lassen." },
    { "component": "Fertigstellung", "text": "Sahne und Zucker steif schlagen." },
    { "component": "Fertigstellung", "text": "Die Sahne in einen Spritzbeutel mit Sterntülle füllen." },
    { "component": "Fertigstellung", "text": "Die Torte mit Sahne, Limettenscheibchen, Blüten und Minzblättern garnieren." }
  ],
  "notes": ""
}
