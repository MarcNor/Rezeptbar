  "steps": [
    { "component": "Mürbeteig", "text": "Puderzucker und Butter cremig rühren." },
    { "component": "Mürbeteig", "text": "Mandeln, Salz und Mehl zugeben." },
    { "component": "Mürbeteig", "text": "Mit dem Ei zügig zu einem glatten Teig verkneten." },
    { "component": "Mürbeteig", "text": "Zu einem Ziegel formen, einwickeln und mindestens 30 Minuten kalt stellen." },
    { "component": "Mürbeteig", "text": "Den Teig 3 mm dick ausrollen." },
    { "component": "Mürbeteig", "text": "Kreise mit 12–13 cm ∅ ausstechen." },
    { "component": "Mürbeteig", "text": "In die gefetteten Ringe legen und die Kanten abschneiden." },
    { "component": "Mürbeteig", "text": "Den Boden mehrfach mit einer Gabel einstechen." },
    { "component": "Mürbeteig", "text": "Ca. 15 Minuten in den Gefrierschrank stellen." },
    { "component": "Mürbeteig", "text": "Bei 180 °C Ober-/Unterhitze ca. 15 Minuten backen." },
    { "component": "Mürbeteig", "text": "Die Ringe abheben und kurz abkühlen lassen." },

    { "component": "Eistreiche", "text": "Eigelb und Sahne verrühren." },
    { "component": "Eistreiche", "text": "Die Tartelettes innen und außen dünn bepinseln." },
    { "component": "Eistreiche", "text": "Ca. 5–10 Minuten nachbacken, bis sie goldbraun sind." },
    { "component": "Eistreiche", "text": "Nach vollständigem Abkühlen die Kanten optional mit der Microplane begradigen." },
    { "component": "Eistreiche", "text": "1–2 Tage in einer luftdichten Blechdose lagerbar." },

    { "component": "Zitrus Gelee", "text": "Die Zitrussäfte und den Abrieb mit dem Gelierzucker mischen." },
    { "component": "Zitrus Gelee", "text": "Nach Packungsangabe ca. 4 Minuten sprudelnd kochen." },
    { "component": "Zitrus Gelee", "text": "Abkühlen lassen." },

    { "component": "Pistazienmousse", "text": "Die Gelatine in eiskaltem Wasser einweichen." },
    { "component": "Pistazienmousse", "text": "Milch, Sahne und Zucker erhitzen." },
    { "component": "Pistazienmousse", "text": "Die Gelatine ausdrücken und darin auflösen." },
    { "component": "Pistazienmousse", "text": "Die heiße Flüssigkeit über die Kuvertüre gießen." },
    { "component": "Pistazienmousse", "text": "1–2 Minuten stehen lassen, dann verrühren." },
    { "component": "Pistazienmousse", "text": "Das Pistazienmus zugeben und mit dem Mixstab pürieren." },
    { "component": "Pistazienmousse", "text": "Auf 30–35 °C abkühlen lassen." },
    { "component": "Pistazienmousse", "text": "Die Sahne cremig schlagen und unterheben." },
    { "component": "Pistazienmousse", "text": "In die Silikonform gießen." },
    { "component": "Pistazienmousse", "text": "Über Nacht einfrieren." },

    { "component": "Zitronen Cremeux", "text": "Die Gelatine einweichen." },
    { "component": "Zitronen Cremeux", "text": "Die Zitronenschale abreiben und die Zitronen auspressen." },
    { "component": "Zitronen Cremeux", "text": "Saft, Schale, Stärke und Zucker aufkochen." },
    { "component": "Zitronen Cremeux", "text": "Die Hitze reduzieren und die Butter stückweise unterrühren." },
    { "component": "Zitronen Cremeux", "text": "Den Topf vom Herd nehmen und die verschlagenen Eier zugeben." },
    { "component": "Zitronen Cremeux", "text": "Bei milder Hitze unter Rühren auf 70–75 °C erhitzen und eindicken lassen." },
    { "component": "Zitronen Cremeux", "text": "Die Gelatine in der heißen Masse auflösen." },
    { "component": "Zitronen Cremeux", "text": "Im Kühlschrank abkühlen lassen." },

    { "component": "Pistazienbiskuit", "text": "Den Backofen auf 180 °C Ober-/Unterhitze vorheizen." },
    { "component": "Pistazienbiskuit", "text": "Das Blech mit Silikonmatte oder Backpapier auslegen." },
    { "component": "Pistazienbiskuit", "text": "Eigelb mit Pistazienmus, der halben Zuckermenge und den Mandeln verrühren." },
    { "component": "Pistazienbiskuit", "text": "Das Eiweiß mit der anderen Zuckerhälfte zu festem Eischnee schlagen." },
    { "component": "Pistazienbiskuit", "text": "Ein Drittel des Eischnees unter die Eigelbmasse heben." },
    { "component": "Pistazienbiskuit", "text": "Den restlichen Eischnee zugeben, das Mehl darübersieben und unterheben." },
    { "component": "Pistazienbiskuit", "text": "Die geschmolzene Butter einarbeiten, die Masse dabei luftig lassen." },
    { "component": "Pistazienbiskuit", "text": "Dünn auf das Blech streichen." },
    { "component": "Pistazienbiskuit", "text": "8–10 Minuten bei 180 °C backen." },
    { "component": "Pistazienbiskuit", "text": "Abkühlen lassen und 6 Kreise in Tartelettegröße ausstechen." },

    { "component": "Aufbau", "text": "Die Mürbeteigschalen mit je ca. 1 EL Zitrus Gelee füllen." },
    { "component": "Aufbau", "text": "Die Pistazienbiskuitkreise einlegen." },
    { "component": "Aufbau", "text": "Mit Zitronen Cremeux auffüllen und glattstreichen." },
    { "component": "Aufbau", "text": "Die Ränder mit gemahlenen grünen Pistazien verzieren." },
    { "component": "Aufbau", "text": "Die Kuvertüre schmelzen und in einen Spritzbeutel füllen." },
    { "component": "Aufbau", "text": "Die gefrorenen Pistazienmoussekreise aus der Form lösen." },
    { "component": "Aufbau", "text": "Die Spritzbeutelspitze abschneiden und mit kreisenden Bewegungen ein feines Muster spritzen." },
    { "component": "Aufbau", "text": "Die goldenen Knusperperlen auf die noch feuchte Kuvertüre setzen." },
    { "component": "Aufbau", "text": "Die Mousse auf die Tartelettes legen." },
    { "component": "Aufbau", "text": "Vor dem Servieren auftauen lassen." }
  ],
  "notes": ""
}
