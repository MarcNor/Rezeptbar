  "steps": [
    { "component": "Aromatisierter Holunderbeerensaft", "text": "Den Saft mit Zimtstange und Zitronenschale zum Kochen bringen." },
    { "component": "Aromatisierter Holunderbeerensaft", "text": "Etwa 15 Minuten leicht köcheln lassen." },

    { "component": "Fruchteinlage", "text": "Die Äpfel schälen, klein würfeln und mit Zitronensaft benetzen." },
    { "component": "Fruchteinlage", "text": "Agar Agar mit 2 TL Zucker und dem Zimt mischen." },
    { "component": "Fruchteinlage", "text": "Die Gelatine einweichen." },
    { "component": "Fruchteinlage", "text": "90 g Zucker bei mittlerer Hitze karamellisieren." },
    { "component": "Fruchteinlage", "text": "Mit dem heißen Holunderbeerensaft ablöschen und rühren, bis keine Klumpen mehr da sind." },
    { "component": "Fruchteinlage", "text": "Die Apfelwürfelchen zugeben." },
    { "component": "Fruchteinlage", "text": "Die Agar-Zucker-Zimt-Mischung einrühren und 2–3 Minuten köcheln lassen." },
    { "component": "Fruchteinlage", "text": "Die Gelatine zugeben." },
    { "component": "Fruchteinlage", "text": "Die Masse in die Tortaflex-Form (16 cm) füllen, abkühlen lassen und einfrieren." },

    { "component": "Boden – Shortbread", "text": "Den Backofen auf 180 °C Ober-/Unterhitze vorheizen." },
    { "component": "Boden – Shortbread", "text": "Butter mit Puderzucker verrühren." },
    { "component": "Boden – Shortbread", "text": "Mehl und Salz zugeben und zu einem Teig verarbeiten." },
    { "component": "Boden – Shortbread", "text": "Den Teig gleichmäßig in der Springform bzw. dem Tortenring verteilen." },
    { "component": "Boden – Shortbread", "text": "10–15 Minuten hellbraun backen." },

    { "component": "Boden – Biskuit", "text": "Das Ei mit Zucker und Zitronenschale hellschaumig schlagen." },
    { "component": "Boden – Biskuit", "text": "Die Sahne zugeben." },
    { "component": "Boden – Biskuit", "text": "Das mit Backpulver vermischte Mehl darübersieben." },
    { "component": "Boden – Biskuit", "text": "Mit dem Öl unterheben." },
    { "component": "Boden – Biskuit", "text": "Die Masse auf dem vorgebackenen Shortbread verteilen." },
    { "component": "Boden – Biskuit", "text": "Bei 170 °C hellbraun backen." },
    { "component": "Boden – Biskuit", "text": "Komplett abkühlen lassen und den Boden bei Bedarf auf maximal 2 cm Dicke gerade schneiden." },

    { "component": "Tränke", "text": "Alle Zutaten im Topf 3 Minuten kochen." },
    { "component": "Tränke", "text": "Die Tränke abkühlen lassen. Sie wird nicht komplett benötigt." },

    { "component": "Holunderbeerenmousse", "text": "Die Gelatine in eiskaltem Wasser einweichen." },
    { "component": "Holunderbeerenmousse", "text": "Ein Viertel des Safts mit dem Zucker aufkochen." },
    { "component": "Holunderbeerenmousse", "text": "Die Gelatine darin auflösen." },
    { "component": "Holunderbeerenmousse", "text": "Den restlichen Saft zugeben." },
    { "component": "Holunderbeerenmousse", "text": "Im Kühlschrank unter gelegentlichem Rühren auf etwa 20 °C gelieren lassen." },
    { "component": "Holunderbeerenmousse", "text": "Die Sahne cremig schlagen." },
    { "component": "Holunderbeerenmousse", "text": "Ein Drittel der Sahne mit dem Schneebesen unter den Saft rühren, den Rest unterheben." },
    { "component": "Holunderbeerenmousse", "text": "Die Mousse gegebenenfalls nochmals kurz kühl stellen – sie darf beim Einfüllen nicht zu flüssig sein, sonst versinkt die gefrorene Fruchtschicht." },

    { "component": "Aufbau", "text": "Zwei Drittel der Holundermousse in die Eclipse-Form füllen." },
    { "component": "Aufbau", "text": "Die gefrorene Apfel-Holunder-Schicht waagerecht eindrücken." },
    { "component": "Aufbau", "text": "Mit Holundermousse bedecken." },
    { "component": "Aufbau", "text": "Die Biskuitseite des Bodens mit Tränke bestreichen." },
    { "component": "Aufbau", "text": "Den Boden mit der Shortbreadseite nach oben einlegen." },
    { "component": "Aufbau", "text": "Lücken mit Mousse auffüllen." },
    { "component": "Aufbau", "text": "Mit Folie abdecken und über Nacht einfrieren." },

    { "component": "Mascarpone-Sahne Aufleger", "text": "Die Gelatine einweichen." },
    { "component": "Mascarpone-Sahne Aufleger", "text": "Die Sahne mit dem Vanillezucker erwärmen." },
    { "component": "Mascarpone-Sahne Aufleger", "text": "Die Gelatine darin auflösen." },
    { "component": "Mascarpone-Sahne Aufleger", "text": "Mit dem Mascarpone verrühren." },
    { "component": "Mascarpone-Sahne Aufleger", "text": "Die Sahne cremig schlagen und unterheben." },
    { "component": "Mascarpone-Sahne Aufleger", "text": "Die Masse auf die 6 Vertiefungen der Quenelle-Form verteilen." },
    { "component": "Mascarpone-Sahne Aufleger", "text": "Mit Folie bedecken und einfrieren." },

    { "component": "Mirrorglaze", "text": "Die Gelatine in eiskaltem Wasser einweichen." },
    { "component": "Mirrorglaze", "text": "Glucosesirup, Wasser bzw. Saft und Zucker zum Kochen bringen – etwas über 100 °C." },
    { "component": "Mirrorglaze", "text": "Den Topf von der Platte ziehen." },
    { "component": "Mirrorglaze", "text": "Unter Rühren die Kondensmilch zugeben." },
    { "component": "Mirrorglaze", "text": "Die Gelatine darin auflösen." },
    { "component": "Mirrorglaze", "text": "Sofort die weiße Kuvertüre zugeben." },
    { "component": "Mirrorglaze", "text": "Eine Minute warten, dann rühren, bis keine Klümpchen mehr da sind." },
    { "component": "Mirrorglaze", "text": "Die Lebensmittelfarbe einrühren." },
    { "component": "Mirrorglaze", "text": "Die Glasur durch ein Sieb gießen." },
    { "component": "Mirrorglaze", "text": "Mit Folie direkt auf der Oberfläche bedecken und bis zur Verwendung kühl stellen." },

    { "component": "Fertigstellung", "text": "Die Mirrorglaze über dem Wasserbad oder in der Mikrowelle auf ca. 40 °C erhitzen." },
    { "component": "Fertigstellung", "text": "Auf ca. 32 °C abkühlen lassen." },
    { "component": "Fertigstellung", "text": "Die gefrorene Torte aus der Form lösen und auf einen Rost über einer Auffangschale stellen." },
    { "component": "Fertigstellung", "text": "Die Glasur gleichmäßig übergießen, sodass Oberfläche und Ränder vollständig bedeckt sind." },
    { "component": "Fertigstellung", "text": "Die Tropfen am Rand mit einer Palette abstreifen." },
    { "component": "Fertigstellung", "text": "Die Torte auf einen Teller stellen." },
    { "component": "Fertigstellung", "text": "Die gefrorenen Klöße aus der Form lösen und mit Velvetspray besprühen." },
    { "component": "Fertigstellung", "text": "Die Klöße mit einem Zahnstocher auf der Torte drapieren." },
    { "component": "Fertigstellung", "text": "Die entstandenen Löchlein mit Blattgold kaschieren." },
    { "component": "Fertigstellung", "text": "Die Zuckerperlen verteilen." },
    { "component": "Fertigstellung", "text": "Die Torte mindestens 2–3 Stunden auftauen lassen, im Kühlschrank entsprechend länger, und möglichst am selben Tag servieren." }
  ],
  "notes": ""
}
