  "steps": [
    { "component": "Exotische Fruchtmousse", "text": "Die Fruchtpürees mit dem Zitronensaft und 35 g Zucker verrühren." },
    { "component": "Exotische Fruchtmousse", "text": "Die Milch zum Kochen bringen." },
    { "component": "Exotische Fruchtmousse", "text": "Eigelb, 20 g Zucker und Stärke verrühren." },
    { "component": "Exotische Fruchtmousse", "text": "Die heiße Milch unterrühren und alles zurück in den Topf geben." },
    { "component": "Exotische Fruchtmousse", "text": "Bei milder Hitze unter stetigem Rühren zu einer Creme verarbeiten, dabei nicht kochen lassen." },
    { "component": "Exotische Fruchtmousse", "text": "Die Gelatine in der Creme auflösen." },
    { "component": "Exotische Fruchtmousse", "text": "Den Mascarpone einrühren." },
    { "component": "Exotische Fruchtmousse", "text": "Die Fruchtzubereitung zugeben." },
    { "component": "Exotische Fruchtmousse", "text": "Auf ca. 20 °C abkühlen lassen und zwischendurch umrühren." },
    { "component": "Exotische Fruchtmousse", "text": "Die Sahne cremig schlagen und unterheben." },
    { "component": "Exotische Fruchtmousse", "text": "In die Universo-Form füllen." },
    { "component": "Exotische Fruchtmousse", "text": "Mindestens 4 Stunden oder über Nacht einfrieren." },

    { "component": "Mürbeteig", "text": "Puderzucker und Butter cremig rühren." },
    { "component": "Mürbeteig", "text": "Mandeln, Salz und Mehl zugeben." },
    { "component": "Mürbeteig", "text": "Mit dem Ei zu einem glatten Teig verkneten." },
    { "component": "Mürbeteig", "text": "Zu einem Ziegel formen und in Frischhaltefolie wickeln." },
    { "component": "Mürbeteig", "text": "Mindestens ½ Stunde in den Kühlschrank legen." },
    { "component": "Mürbeteig", "text": "Den Teig 3 mm dick ausrollen." },
    { "component": "Mürbeteig", "text": "Den Tartering damit auslegen und die Kanten sauber abschneiden." },
    { "component": "Mürbeteig", "text": "Den Boden mehrfach mit einer Gabel einstechen." },
    { "component": "Mürbeteig", "text": "Mindestens 15 Minuten in den Gefrierschrank stellen – das ersetzt das Blindbacken." },
    { "component": "Mürbeteig", "text": "Den Backofen auf 180 °C Ober-/Unterhitze aufheizen." },

    { "component": "Frangipane mit Kokos", "text": "Alle Zutaten außer den Früchten zu einer luftigen Creme verrühren." },
    { "component": "Frangipane mit Kokos", "text": "Die Creme auf dem gekühlten Mürbeteigboden verstreichen." },
    { "component": "Frangipane mit Kokos", "text": "Die Physalisfrüchte in die Creme drücken, sie dürfen nicht über den Rand hinausragen." },
    { "component": "Frangipane mit Kokos", "text": "Bei 180 °C Ober-/Unterhitze ca. 30 Minuten goldbraun backen." },
    { "component": "Frangipane mit Kokos", "text": "Auf einem Rost vollständig abkühlen lassen." },

    { "component": "Drachenfruchtglasur", "text": "Alle Zutaten im Topf zum Kochen bringen." },
    { "component": "Drachenfruchtglasur", "text": "Ca. 2 Minuten sprudelnd kochen." },
    { "component": "Drachenfruchtglasur", "text": "Auf ca. 35 °C abkühlen lassen." },

    { "component": "Fertigstellung", "text": "Die gefrorene Fruchtmousse aus der Silikonform lösen und auf einen Rost über einer Auffangschale legen." },
    { "component": "Fertigstellung", "text": "Die 35 °C warme Glasur über die gefrorene Mousse gießen und einen kleinen Rest übrig lassen." },
    { "component": "Fertigstellung", "text": "Der Guss erstarrt sofort auf der gefrorenen Mousse." },
    { "component": "Fertigstellung", "text": "Die Oberfläche der Mürbeteigtarte mit einer dünnen Schicht Glasur bestreichen." },
    { "component": "Fertigstellung", "text": "Die gefrorene Mousse vorsichtig darauf platzieren." },
    { "component": "Fertigstellung", "text": "Den überstehenden Rand mit Früchten und Zitronenmelisse dekorieren." },
    { "component": "Fertigstellung", "text": "Aufgeschnittenes Obst optional mit Fruchtglasur vor dem Austrocknen schützen." }
  ],
  "notes": ""
}
