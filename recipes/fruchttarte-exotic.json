    { "component": "Mürbeteig", "amount": "140", "unit": "g", "name": "Mehl Type 550" },

    { "component": "Frangipane mit Kokos", "amount": "70", "unit": "g", "name": "weiche Butter" },
    { "component": "Frangipane mit Kokos", "amount": "40", "unit": "g", "name": "gemahlene Mandeln" },
    { "component": "Frangipane mit Kokos", "amount": "30", "unit": "g", "name": "Kokosflocken" },
