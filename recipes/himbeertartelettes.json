    { "component": "Dinkelmürbeteig", "amount": "45", "unit": "g", "name": "verquirltes Ei" },
    { "component": "Dinkelmürbeteig", "amount": "1", "unit": "Prise", "name": "Salz" },

    { "component": "Eistreiche", "amount": "1", "unit": "", "name": "Eigelb" },
    { "component": "Eistreiche", "amount": "1", "unit": "TL", "name": "Sahne" },

    { "component": "Biskuit", "amount": "2", "unit": "", "name": "Eigelb" },
    { "component": "Biskuit", "amount": "25", "unit": "g", "name": "Zucker A" },
    { "component": "Biskuit", "amount": "2", "unit": "", "name": "Eiweiß" },
    { "component": "Biskuit", "amount": "25", "unit": "g", "name": "Zucker B" },
    { "component": "Biskuit", "amount": "25", "unit": "g", "name": "Mehl" },
    { "component": "Biskuit", "amount": "25", "unit": "g", "name": "Stärke" },

    { "component": "Transparente Glasur (optional)", "amount": "50", "unit": "g", "name": "Wasser" },
    { "component": "Transparente Glasur (optional)", "amount": "10", "unit": "g", "name": "Zitronensaft" },
    { "component": "Transparente Glasur (optional)", "amount": "60", "unit": "g", "name": "Zucker" },
    { "component": "Transparente Glasur (optional)", "amount": "70", "unit": "g", "name": "Glucosesirup" },
    { "component": "Transparente Glasur (optional)", "amount": "3", "unit": "Blatt", "name": "Gelatine" },

    { "component": "Fertigstellung", "amount": "", "unit": "", "name": "Himbeerpüree zum Tränken" },
    { "component": "Fertigstellung", "amount": "", "unit": "", "name": "frische Himbeeren" },
    { "component": "Fertigstellung", "amount": "", "unit": "", "name": "essbares Gold" }
  ],
  "steps": [
    { "component": "Himbeermousse", "text": "Die Gelatine in eiskaltem Wasser einweichen." },
    { "component": "Himbeermousse", "text": "Das Himbeerpüree mit dem Zucker erhitzen." },
    { "component": "Himbeermousse", "text": "Die ausgedrückte Gelatine darin auflösen." },
    { "component": "Himbeermousse", "text": "Auf 30 °C abkühlen lassen." },
    { "component": "Himbeermousse", "text": "Die halbsteif geschlagene Sahne unterheben." },
    { "component": "Himbeermousse", "text": "In 6 Mulden der Halbkugel-Silikonform füllen." },
    { "component": "Himbeermousse", "text": "Glattstreichen und mit Folie bedeckt einfrieren." },

    { "component": "Himbeercoulis", "text": "Das Himbeerpüree mit dem Gelierzucker vermischen." },
    { "component": "Himbeercoulis", "text": "Ca. 4 Minuten sprudelnd kochen." },
    { "component": "Himbeercoulis", "text": "In ein sauberes Glas füllen." },
    { "component": "Himbeercoulis", "text": "Im Kühlschrank gelieren lassen." },

    { "component": "Himbeermarshmallow", "text": "Die Form mit Folie auslegen und dünn mit Öl einpinseln." },
    { "component": "Himbeermarshmallow", "text": "Das Himbeerpüree mit der gemahlenen Gelatine vermengen und 5 Minuten quellen lassen." },
    { "component": "Himbeermarshmallow", "text": "Den Zucker zugeben und unter Rühren auf 80 °C erhitzen." },
    { "component": "Himbeermarshmallow", "text": "Den Glucosesirup in eine Rührschüssel geben und die Fruchtmasse zugeben." },
    { "component": "Himbeermarshmallow", "text": "Mit dem elektrischen Mixgerät ca. 5 Minuten mixen, bis die Masse hellschaumig ist." },
    { "component": "Himbeermarshmallow", "text": "Ca. 1 cm hoch in die Form füllen und glattstreichen." },
    { "component": "Himbeermarshmallow", "text": "Bei Zimmertemperatur fest werden lassen, gerne über Nacht." },
    { "component": "Himbeermarshmallow", "text": "In kleine Würfel schneiden." },
    { "component": "Himbeermarshmallow", "text": "In der Puderzucker-Stärke-Mischung wälzen und den Überschuss abschütteln." },
    { "component": "Himbeermarshmallow", "text": "In einem verschlossenen Kunststoffbehälter bei Zimmertemperatur lagern." },

    { "component": "Dinkelmürbeteig", "text": "Puderzucker und Butter cremig rühren." },
    { "component": "Dinkelmürbeteig", "text": "Mandeln, Salz und Mehl zugeben." },
    { "component": "Dinkelmürbeteig", "text": "Mit dem Ei zügig zu einem glatten Teig verkneten." },
    { "component": "Dinkelmürbeteig", "text": "Zu einem Ziegel formen und in Folie wickeln." },
    { "component": "Dinkelmürbeteig", "text": "Mindestens 1 Stunde in den Kühlschrank legen." },
    { "component": "Dinkelmürbeteig", "text": "Den Teig 3 mm dick ausrollen." },
    { "component": "Dinkelmürbeteig", "text": "Die Ringe fetten und auf ein Blech setzen." },
    { "component": "Dinkelmürbeteig", "text": "Böden ausstechen und Randstreifen zuschneiden, 0,5 cm breiter als der Ring." },
    { "component": "Dinkelmürbeteig", "text": "Die überstehenden Kanten abschneiden." },
    { "component": "Dinkelmürbeteig", "text": "Den Boden mehrfach mit einer Gabel einstechen." },
    { "component": "Dinkelmürbeteig", "text": "Ca. 15 Minuten in den Gefrierschrank stellen – das erspart das Blindbacken und verhindert, dass die Ränder absinken." },
    { "component": "Dinkelmürbeteig", "text": "Bei 180 °C Ober-/Unterhitze ca. 15 Minuten backen." },
    { "component": "Dinkelmürbeteig", "text": "Die Ringe abheben und abkühlen lassen." },

    { "component": "Eistreiche", "text": "Eigelb und Sahne verrühren." },
    { "component": "Eistreiche", "text": "Die Tartelettes innen und außen dünn bestreichen." },
    { "component": "Eistreiche", "text": "Nochmals ca. 5–10 Minuten backen, bis sie goldbraun sind." },
    { "component": "Eistreiche", "text": "Optional die Ränder mit der Microplane-Reibe begradigen." },

    { "component": "Biskuit", "text": "Den Backofen auf 200 °C vorheizen." },
    { "component": "Biskuit", "text": "Das Eigelb mit Zucker A hellschaumig aufschlagen." },
    { "component": "Biskuit", "text": "Das Eiweiß mit Zucker B zu Eischnee aufschlagen." },
    { "component": "Biskuit", "text": "Den Eischnee sachte unter die Eigelbmasse heben." },
    { "component": "Biskuit", "text": "Mehl und Stärke mischen und darübersieben." },
    { "component": "Biskuit", "text": "Alles unterheben." },
    { "component": "Biskuit", "text": "1 cm dick auf ein Backblech mit Papier oder Backmatte streichen." },
    { "component": "Biskuit", "text": "Ca. 10 Minuten backen." },
    { "component": "Biskuit", "text": "Abkühlen lassen und 6 Kreise mit ca. 5,5 cm ∅ ausstechen. Den Rest einfrieren." },

    { "component": "Transparente Glasur (optional)", "text": "Die Gelatine in eiskaltem Wasser einweichen." },
    { "component": "Transparente Glasur (optional)", "text": "Die restlichen Zutaten aufkochen und leise köcheln lassen, bis der Zucker gelöst ist." },
    { "component": "Transparente Glasur (optional)", "text": "Vom Herd nehmen." },
    { "component": "Transparente Glasur (optional)", "text": "Die ausgedrückte Gelatine auflösen." },
    { "component": "Transparente Glasur (optional)", "text": "Mit Folie bedeckt über Nacht im Kühlschrank erstarren lassen." },
    { "component": "Transparente Glasur (optional)", "text": "Zum Gießen auf ca. 30 °C erwärmen, sodass sie wie Sahne fließt." },

    { "component": "Fertigstellung", "text": "Eine Schicht Himbeercoulis auf dem Tarteletteboden verteilen." },
    { "component": "Fertigstellung", "text": "Einen Biskuitkreis darauflegen." },
    { "component": "Fertigstellung", "text": "Mit Himbeerpüree bestreichen." },
    { "component": "Fertigstellung", "text": "Erneut Himbeercoulis auftragen." },
    { "component": "Fertigstellung", "text": "Die Himbeermousse-Halbkugel mittig auflegen." },
    { "component": "Fertigstellung", "text": "Optional die Mousse mit der transparenten Glasur überziehen." },
    { "component": "Fertigstellung", "text": "Abwechselnd Himbeeren und Marshmallowwürfel rund um die Mousse anordnen." },
    { "component": "Fertigstellung", "text": "Mit essbarem Gold dekorieren." }
  ],
  "notes": ""
}
