    { "component": "Himbeermousse", "amount": "80", "unit": "g", "name": "Schlagsahne" },

    { "component": "Himbeercoulis", "amount": "200", "unit": "g", "name": "ungesüßtes Himbeerpüree" },
    { "component": "Himbeercoulis", "amount": "110", "unit": "g", "name": "Gelierzucker 2:1" },

