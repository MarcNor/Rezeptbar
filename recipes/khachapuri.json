  "steps": [
    { "component": "Hefeteig", "text": "Den Pizzastein auf der untersten Schiene einsetzen und den Ofen auf 50 °C vorheizen." },
    { "component": "Hefeteig", "text": "Die Hefe zerbröckeln und alle Zutaten vermischen." },
    { "component": "Hefeteig", "text": "2 Minuten langsam kneten, dann 5 Minuten kräftiger kneten." },
    { "component": "Hefeteig", "text": "Mit einem feuchten Tuch abdecken und 30 Minuten im ausgeschalteten Ofen gehen lassen." },
    { "component": "Hefeteig", "text": "Den Ofen anschließend auf 250 °C Grill mit Umluft vorheizen." },

    { "component": "Käse-Füllung", "text": "Den Feta zerbröckeln und den Mozzarella zerreißen." },
    { "component": "Käse-Füllung", "text": "Mit Käsemix, Ricotta und Pfeffer verrühren." },

    { "component": "Fertigstellung", "text": "Den Teig in 3 Teile teilen, zu Kugeln formen und 5 Minuten ruhen lassen." },
    { "component": "Fertigstellung", "text": "Zu Ovalen ausrollen." },
    { "component": "Fertigstellung", "text": "Die Ränder der langen Seiten nach innen falten, die Spitzen verdrehen und zusammendrücken." },
    { "component": "Fertigstellung", "text": "Mit der Käsemasse befüllen." },
    { "component": "Fertigstellung", "text": "10 Minuten bei Zimmertemperatur gehen lassen." },
    { "component": "Fertigstellung", "text": "Auf dem Pizzastein ca. 10 Minuten backen." },

    { "component": "Dekoration", "text": "Je zwei Eigelbe pro Brot in die Vertiefungen geben." },
    { "component": "Dekoration", "text": "Weitere 2–3 Minuten backen." },
    { "component": "Dekoration", "text": "Mit Knoblauchbutter bestreichen." },
    { "component": "Dekoration", "text": "Petersilie und Schnittlauch fein hacken und zusammen mit dem Fleur de Sel darauf verteilen." }
  ],
  "notes": ""
