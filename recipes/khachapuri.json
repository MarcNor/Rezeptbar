    { "component": "Hefeteig", "amount": "8", "unit": "g", "name": "Hefe" },
    { "component": "Hefeteig", "amount": "9", "unit": "ml", "name": "Olivenöl" },
    { "component": "Hefeteig", "amount": "230", "unit": "g", "name": "Mehl" },
    { "component": "Hefeteig", "amount": "5", "unit": "g", "name": "Salz" },
    { "component": "Hefeteig", "amount": "", "unit": "", "name": "etwas Semola" },

    { "component": "Käse-Füllung", "amount": "75", "unit": "g", "name": "Feta" },
    { "component": "Käse-Füllung", "amount": "150", "unit": "g", "name": "Mozzarella" },
    { "component": "Käse-Füllung", "amount": "30", "unit": "g", "name": "geriebener Käsemix" },
    { "component": "Käse-Füllung", "amount": "75", "unit": "g", "name": "Ricotta" },
    { "component": "Käse-Füllung", "amount": "1", "unit": "Prise", "name": "Pfeffer" },

    { "component": "Dekoration", "amount": "6", "unit": "", "name": "Eigelbe" },
    { "component": "Dekoration", "amount": "", "unit": "", "name": "etwas Butter" },
    { "component": "Dekoration", "amount": "", "unit": "", "name": "etwas Knoblauch" },
    { "component": "Dekoration", "amount": "", "unit": "", "name": "etwas krause Petersilie" },
    { "component": "Dekoration", "amount": "", "unit": "", "name": "etwas Schnittlauch" },
    { "component": "Dekoration", "amount": "", "unit": "", "name": "etwas Fleur de Sel" }
