  "steps": [
    { "component": "Pfefferminzmousse", "text": "Die Gelatine in eiskaltem Wasser einweichen." },
    { "component": "Pfefferminzmousse", "text": "Milch mit Zucker und Eigelb auf mittlerer Stufe auf 85 °C erwärmen." },
    { "component": "Pfefferminzmousse", "text": "Sofort vom Herd nehmen und die gut ausgedrückte Gelatine auflösen." },
    { "component": "Pfefferminzmousse", "text": "Limettensaft und Minzblätter zugeben." },
    { "component": "Pfefferminzmousse", "text": "Mit dem Stabmixer pürieren." },
    { "component": "Pfefferminzmousse", "text": "Das Pfefferminzöl tropfenweise nach Geschmack zugeben." },
    { "component": "Pfefferminzmousse", "text": "Die Sahne cremig schlagen und unterheben." },
    { "component": "Pfefferminzmousse", "text": "Die Mousse in die Bubble-Silikonform füllen und einfrieren." },

    { "component": "Schokomürbeteig", "text": "Butter und Puderzucker cremig rühren." },
    { "component": "Schokomürbeteig", "text": "Die übrigen Zutaten zugeben und schnell zu einem glatten Teig verarbeiten." },
    { "component": "Schokomürbeteig", "text": "Den Teig in Frischhaltefolie 1 Stunde kühl stellen." },
    { "component": "Schokomürbeteig", "text": "Den Teig 3–4 mm dick ausrollen." },
    { "component": "Schokomürbeteig", "text": "Den Tartering damit auskleiden und die Ränder abschneiden." },
    { "component": "Schokomürbeteig", "text": "Den Boden mehrmals mit einer Gabel einstechen." },
    { "component": "Schokomürbeteig", "text": "10 Minuten ins Tiefkühlfach stellen." },
    { "component": "Schokomürbeteig", "text": "Bei 180 °C Ober-/Unterhitze 15–18 Minuten backen." },
    { "component": "Schokomürbeteig", "text": "Auf einem Rost abkühlen lassen." },
    { "component": "Schokomürbeteig", "text": "Die Teigreste ausrollen, mit einer Keksform ausstechen und ca. 10–12 Minuten backen." },
    { "component": "Schokomürbeteig", "text": "30 g der Kekse für die Ganache zurücklegen." },
    { "component": "Schokomürbeteig", "text": "Die ausgekühlte Tarte mit geschmolzener Kuvertüre grundieren." },

    { "component": "Schokoladenganache", "text": "Die Kekse zerbröseln und die Mandeln in der Pfanne anrösten." },
    { "component": "Schokoladenganache", "text": "Die Kuvertüre in der Mikrowelle oder über dem Wasserbad schmelzen." },
    { "component": "Schokoladenganache", "text": "Die Sahne aufkochen." },
    { "component": "Schokoladenganache", "text": "Die Sahne in drei Portionen zur Kuvertüre geben und jeweils glattrühren." },
    { "component": "Schokoladenganache", "text": "Bei 35–40 °C mit dem Stabmixer emulgieren." },
    { "component": "Schokoladenganache", "text": "Die weiche Butter einarbeiten." },
    { "component": "Schokoladenganache", "text": "Mandeln und Keksstreusel zugeben." },
    { "component": "Schokoladenganache", "text": "Die Ganache bis zum Rand in die Tarte füllen." },
    { "component": "Schokoladenganache", "text": "An einem kühlen Ort fest werden lassen." },

    { "component": "Fertigstellung", "text": "Den Rand mit Kakao besieben." },
    { "component": "Fertigstellung", "text": "Die gefrorene Minzcreme aus der Form nehmen." },
    { "component": "Fertigstellung", "text": "Mit weißem Velvetspray besprühen." },
    { "component": "Fertigstellung", "text": "Anschließend mit einem Hauch grünem Velvetspray besprühen." },
    { "component": "Fertigstellung", "text": "Die Creme auf der Tarte platzieren." },
    { "component": "Fertigstellung", "text": "Mit Schokoladendekor und Gold dekorieren." },
    { "component": "Fertigstellung", "text": "Vor dem Servieren komplett auftauen lassen." }
  ],
  "notes": ""
}
