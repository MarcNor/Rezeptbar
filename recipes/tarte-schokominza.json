    { "component": "Schokoladenganache", "amount": "40", "unit": "g", "name": "gehackte Mandeln" },
    { "component": "Schokoladenganache", "amount": "120", "unit": "g", "name": "dunkle Kuvertüre (55 %)" },
    { "component": "Schokoladenganache", "amount": "110", "unit": "g", "name": "Sahne" },
    { "component": "Schokoladenganache", "amount": "20", "unit": "g", "name": "Butter" },

    { "component": "Fertigstellung", "amount": "", "unit": "", "name": "dunkler Backkakao" },
    { "component": "Fertigstellung", "amount": "", "unit": "", "name": "weißes Velvetspray" },
    { "component": "Fertigstellung", "amount": "", "unit": "", "name": "grünes Velvetspray" },
    { "component": "Fertigstellung", "amount": "", "unit": "", "name": "Schokoladendekor" },
    { "component": "Fertigstellung", "amount": "", "unit": "", "name": "essbares Gold" }
