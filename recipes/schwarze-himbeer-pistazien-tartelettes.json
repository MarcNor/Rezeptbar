  "steps": [
    { "component": "Schwarzer Mürbeteig", "text": "Die weiche Butter mit beiden Zuckersorten und der Aktivkohle verrühren." },
    { "component": "Schwarzer Mürbeteig", "text": "Das Ei schrittweise zugeben." },
    { "component": "Schwarzer Mürbeteig", "text": "Das Mehl kurz einarbeiten." },
    { "component": "Schwarzer Mürbeteig", "text": "In Folie wickeln und mindestens 6 Stunden kalt stellen." },

    { "component": "Himbeermousse", "text": "Die Gelatine in eiskaltem Wasser einweichen." },
    { "component": "Himbeermousse", "text": "Ein Drittel des Pürees mit dem Zucker erwärmen und die Gelatine darin auflösen." },
    { "component": "Himbeermousse", "text": "Das restliche Püree und das Rosenwasser zugeben." },
    { "component": "Himbeermousse", "text": "Nach leichtem Gelieren die Sahne cremig schlagen und unterheben." },
    { "component": "Himbeermousse", "text": "Die Mousse in 5 Silikonvertiefungen füllen, bis 1 cm unter den Rand." },
    { "component": "Himbeermousse", "text": "Die Lychees abtropfen lassen, vierteln und hineindrücken." },
    { "component": "Himbeermousse", "text": "Über Nacht in den Gefrierschrank stellen." },

    { "component": "Tartelettes formen", "text": "Die Ringe leicht buttern und auf ein Blech stellen." },
    { "component": "Tartelettes formen", "text": "Den Teig 3–4 mm dick ausrollen." },
    { "component": "Tartelettes formen", "text": "5 Streifen von 3,5 cm Breite ausschneiden und in die Ringe einpassen." },
    { "component": "Tartelettes formen", "text": "5 Kreise von knapp 8 cm ∅ ausstechen und in die Tartelettes legen." },
    { "component": "Tartelettes formen", "text": "Die Innenkanten verstreichen und den Boden mehrfach mit einer Gabel einstechen." },
    { "component": "Tartelettes formen", "text": "30 Minuten gefrieren." },

    { "component": "Pistazienfrangipane", "text": "Alle Zutaten mit dem Mixgerät zu einer fluffigen Masse verrühren." },

    { "component": "Backen", "text": "Den Ofen auf 180 °C Ober-/Unterhitze vorheizen." },
    { "component": "Backen", "text": "Die überstehenden Teigränder mit einem Messer abschneiden." },
    { "component": "Backen", "text": "Die Frangipane einfüllen und glattstreichen." },
    { "component": "Backen", "text": "20–25 Minuten backen." },
    { "component": "Backen", "text": "Auf einem Rost abkühlen lassen." },

    { "component": "Transparente Glasur", "text": "Die Gelatine einweichen." },
    { "component": "Transparente Glasur", "text": "Wasser, Zucker und Zitronensaft erhitzen, bis der Zucker gelöst ist." },
    { "component": "Transparente Glasur", "text": "Die Gelatine auflösen." },
    { "component": "Transparente Glasur", "text": "Auf 32–35 °C abkühlen lassen." },

    { "component": "Fertigstellung", "text": "Die gefrorenen Mousse-Törtchen aus der Form lösen." },
    { "component": "Fertigstellung", "text": "Auf ein Gitter über einer Schale setzen." },
    { "component": "Fertigstellung", "text": "Die Glasur gleichmäßig übergießen." },
    { "component": "Fertigstellung", "text": "Die Tartelettes mit Himbeergelee bestreichen." },
    { "component": "Fertigstellung", "text": "Die gemahlenen Pistazien mit einem Esslöffel am unteren Rand andrücken." },
    { "component": "Fertigstellung", "text": "Die Mousse-Törtchen auf die Tartelettes setzen." },
    { "component": "Fertigstellung", "text": "Die Garnitur erst am Serviertag auflegen." }
  ],
  "notes": ""
