  "steps": [
    { "component": "Kirschkompott", "text": "Die Gelatine in eiskaltem Wasser einweichen." },
    { "component": "Kirschkompott", "text": "Zucker und Stärkemehl vermischen." },
    { "component": "Kirschkompott", "text": "Mit Kirschen, Zimtstange und Orangensaft zu einem Kompott kochen." },
    { "component": "Kirschkompott", "text": "Die Gelatine auflösen und das Kompott abkühlen lassen." },
    { "component": "Kirschkompott", "text": "In die Tortaflex-Form geben und im Kühl- oder Gefrierschrank gelieren lassen." },

    { "component": "Vanillecreme", "text": "Die Gelatine in Eiswasser einweichen." },
    { "component": "Vanillecreme", "text": "Milch, Sahne und Vanillemark aufkochen." },
    { "component": "Vanillecreme", "text": "Eigelb und Zucker verrühren und die heiße Mischung unterrühren." },
    { "component": "Vanillecreme", "text": "Auf 83–85 °C bringen." },
    { "component": "Vanillecreme", "text": "Die Gelatine auflösen und die Creme durchsieben." },
    { "component": "Vanillecreme", "text": "Die Schlagsahne cremig schlagen und unterziehen." },
    { "component": "Vanillecreme", "text": "Die Creme auf dem gelierten Kompott verteilen." },
    { "component": "Vanillecreme", "text": "Über Nacht einfrieren." },

    { "component": "Haferflockenteig", "text": "Den Backofen auf 175 °C vorheizen und die Springform einfetten." },
    { "component": "Haferflockenteig", "text": "Butter und Zucker hellschaumig rühren, das Ei unterrühren." },
    { "component": "Haferflockenteig", "text": "Mehl, Stärke und Backpulver sieben und die Haferflocken zugeben." },
    { "component": "Haferflockenteig", "text": "Den Teig in die Form füllen und glattstreichen." },
    { "component": "Haferflockenteig", "text": "15–20 Minuten backen." },
    { "component": "Haferflockenteig", "text": "Abkühlen lassen und einen Kreis mit 17 cm ∅ ausstechen." },

    { "component": "Schokoladenmousse mit Zimt", "text": "Die Gelatine in Eiswasser einweichen." },
    { "component": "Schokoladenmousse mit Zimt", "text": "120 g Milch mit den Zimtstangen kurz aufkochen und 10 Minuten durchziehen lassen." },
    { "component": "Schokoladenmousse mit Zimt", "text": "100 g der aromatisierten Milch abmessen und wieder erhitzen." },
    { "component": "Schokoladenmousse mit Zimt", "text": "Eigelb und Zucker verrühren und die heiße Zimtmilch unterrühren." },
    { "component": "Schokoladenmousse mit Zimt", "text": "Auf 83–85 °C bringen." },
    { "component": "Schokoladenmousse mit Zimt", "text": "Die Gelatine auflösen und die Masse über die gehackte Kuvertüre gießen, 1–2 Minuten stehen lassen." },
    { "component": "Schokoladenmousse mit Zimt", "text": "Mit dem Stabmixer emulgieren." },
    { "component": "Schokoladenmousse mit Zimt", "text": "Die Schlagsahne cremig schlagen und bei 40–45 °C unterziehen." },

    { "component": "Aufbau", "text": "Zwei Drittel der Schokoladenmousse in die Universo-Form geben." },
    { "component": "Aufbau", "text": "Die gefrorene Kirsch-Vanille-Einlage mit der Vanilleschicht nach unten eindrücken." },
    { "component": "Aufbau", "text": "Mit Mousse bedecken und mit Knusperperlen bestreuen." },
    { "component": "Aufbau", "text": "Den Haferflockenteig mit Amaretto tränken und auflegen." },
    { "component": "Aufbau", "text": "Glattstreichen und über Nacht einfrieren." },

    { "component": "Schokoladen-Glanzglasur", "text": "Die Gelatine einweichen." },
    { "component": "Schokoladen-Glanzglasur", "text": "Zucker, Wasser und Glucosesirup auf 103 °C kochen." },
    { "component": "Schokoladen-Glanzglasur", "text": "Sahne und gesiebten Kakao unterrühren." },
    { "component": "Schokoladen-Glanzglasur", "text": "Die Gelatine auflösen." },
    { "component": "Schokoladen-Glanzglasur", "text": "Mit dem Stabmixer kurz mixen, dabei möglichst wenig Luft einarbeiten, und durch ein Sieb gießen." },
    { "component": "Schokoladen-Glanzglasur", "text": "Mit Folie abdecken und über Nacht in den Kühlschrank stellen." },

    { "component": "Fertigstellung", "text": "Den Kakao sieben und griffbereit in ein Sieb füllen." },
    { "component": "Fertigstellung", "text": "Die Glasur im Wasserbad oder in der Mikrowelle auf 45 °C erwärmen und auf 35 °C abkühlen lassen." },
    { "component": "Fertigstellung", "text": "Die Torte aus der Form lösen und auf einen Rost über einer Schale stellen." },
    { "component": "Fertigstellung", "text": "Mit der Glasur übergießen und sofort mit Kakao überpudern, solange die Glasur noch fließt." },
    { "component": "Fertigstellung", "text": "Durch die fließende Glasur und leichtes Rütteln entsteht der zerklüftete Effekt." },
    { "component": "Fertigstellung", "text": "Die Torte auftauen lassen." }
  ],
  "notes": ""
}
