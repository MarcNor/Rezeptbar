  "steps": [
    { "component": "Madeleineteig mit Johannisbeeren", "text": "Den Backofen auf 180 °C vorheizen." },
    { "component": "Madeleineteig mit Johannisbeeren", "text": "Die Springform (18 cm ∅) mit Backpapier auslegen." },
    { "component": "Madeleineteig mit Johannisbeeren", "text": "Ei und Zucker hellschaumig schlagen." },
    { "component": "Madeleineteig mit Johannisbeeren", "text": "Mehl und Backpulver darübersieben und mit Zitronenabrieb und Zitronensaft verquirlen." },
    { "component": "Madeleineteig mit Johannisbeeren", "text": "Die geschmolzene Butter und das Öl unterrühren." },
    { "component": "Madeleineteig mit Johannisbeeren", "text": "Den Teig in die Springform füllen." },
    { "component": "Madeleineteig mit Johannisbeeren", "text": "Die roten Johannisbeeren auf der Oberfläche verteilen." },
    { "component": "Madeleineteig mit Johannisbeeren", "text": "Ca. 25 Minuten backen." },
    { "component": "Madeleineteig mit Johannisbeeren", "text": "Völlig auskühlen lassen." },
    { "component": "Madeleineteig mit Johannisbeeren", "text": "Einen Kreis mit 16 cm ∅ ausschneiden." },
    { "component": "Madeleineteig mit Johannisbeeren", "text": "Mit der Backhautseite nach unten in die Tortaflexform legen." },

    { "component": "Cassiscreme", "text": "Die Gelatine in eiskaltem Wasser einweichen." },
    { "component": "Cassiscreme", "text": "Die Kuvertüre schmelzen." },
    { "component": "Cassiscreme", "text": "Das Johannisbeerpüree erhitzen." },
    { "component": "Cassiscreme", "text": "Das Püree zur Kuvertüre geben." },
    { "component": "Cassiscreme", "text": "Die ausgedrückte Gelatine zugeben." },
    { "component": "Cassiscreme", "text": "Mit dem Stabmixer kräftig durchmixen." },
    { "component": "Cassiscreme", "text": "Den Cassislikör zugeben." },
    { "component": "Cassiscreme", "text": "Die kalte Sahne zugeben und noch eine Minute mixen." },
    { "component": "Cassiscreme", "text": "In den Kühlschrank stellen und zwischendurch umrühren." },
    { "component": "Cassiscreme", "text": "Sobald die Creme zu gelieren beginnt, auf dem Madeleineteig verteilen." },

    { "component": "Pistazienbiskuit", "text": "Den Backofen auf 180 °C Ober-/Unterhitze vorheizen." },
    { "component": "Pistazienbiskuit", "text": "Die gemahlenen Nüsse mit dem Puderzucker, 1 Ei und 1 Eigelb hellschaumig schlagen." },
    { "component": "Pistazienbiskuit", "text": "Das Pistazienmus unterrühren." },
    { "component": "Pistazienbiskuit", "text": "Das Eiweiß mit 10 g Zucker zu Eischnee schlagen." },
    { "component": "Pistazienbiskuit", "text": "Ein Drittel des Eischnees zur Eigelbmasse geben und unterrühren." },
    { "component": "Pistazienbiskuit", "text": "Den restlichen Eischnee, das gesiebte Mehl und die geschmolzene Butter unterziehen." },
    { "component": "Pistazienbiskuit", "text": "Die Masse kreisförmig auf Backpapier oder Backmatte streichen." },
    { "component": "Pistazienbiskuit", "text": "Ca. 10–12 Minuten backen." },
    { "component": "Pistazienbiskuit", "text": "Auskühlen lassen und einen Kreis mit 16 cm ∅ ausschneiden." },
    { "component": "Pistazienbiskuit", "text": "Auf der Cassiscremeschicht platzieren." },
    { "component": "Pistazienbiskuit", "text": "Die Tortaflexform mit der Torteneinlage einfrieren." },

    { "component": "Pistazienknusperboden – Streusel", "text": "Den Backofen auf 160 °C Ober-/Unterhitze vorheizen." },
    { "component": "Pistazienknusperboden – Streusel", "text": "Alle Zutaten rasch zu einem Streuselteig verarbeiten." },
    { "component": "Pistazienknusperboden – Streusel", "text": "Auf Silikonmatte oder Backpapier verteilen." },
    { "component": "Pistazienknusperboden – Streusel", "text": "Ca. 20–25 Minuten goldbraun backen." },

    { "component": "Pistazienknusperboden – Zusammensetzung", "text": "Streusel und Waffelröllchen etwas feiner bröseln." },
    { "component": "Pistazienknusperboden – Zusammensetzung", "text": "Die Pistazien zugeben." },
    { "component": "Pistazienknusperboden – Zusammensetzung", "text": "Die Kuvertüre schmelzen." },
    { "component": "Pistazienknusperboden – Zusammensetzung", "text": "Kuvertüre und Pistazienmus zur Streuselmasse geben und alles vermischen." },
    { "component": "Pistazienknusperboden – Zusammensetzung", "text": "Zwischen zwei Lagen Backpapier 3 mm dick ausrollen." },
    { "component": "Pistazienknusperboden – Zusammensetzung", "text": "Auf einer Platte mindestens 30 Minuten in den Kühlschrank legen." },
    { "component": "Pistazienknusperboden – Zusammensetzung", "text": "Die obere Backpapierschicht abziehen." },
    { "component": "Pistazienknusperboden – Zusammensetzung", "text": "Einen Kreis mit 17 cm ∅ ausschneiden." },
    { "component": "Pistazienknusperboden – Zusammensetzung", "text": "Bis zur Verwendung im Gefrierschrank lagern." },

    { "component": "Johannisbeer-Ricotta Mousse", "text": "Die Gelatine einweichen." },
    { "component": "Johannisbeer-Ricotta Mousse", "text": "Das Johannisbeerpüree mit dem Zucker aufkochen." },
    { "component": "Johannisbeer-Ricotta Mousse", "text": "Die ausgedrückte Gelatine darin auflösen." },
    { "component": "Johannisbeer-Ricotta Mousse", "text": "Ricotta und Zitronensaft glattrühren." },
    { "component": "Johannisbeer-Ricotta Mousse", "text": "Das Johannisbeerpüree zugeben und gut verrühren." },
    { "component": "Johannisbeer-Ricotta Mousse", "text": "Die Creme auf ca. 30 °C abkühlen lassen und zwischendurch umrühren." },
    { "component": "Johannisbeer-Ricotta Mousse", "text": "Die halbsteif geschlagene Schlagsahne unterziehen." },

    { "component": "Aufbau", "text": "Die Universoform mit Tortenrandfolie um ca. 5 cm erhöhen." },
    { "component": "Aufbau", "text": "Drei Viertel der Johannisbeer-Ricotta Mousse in die erhöhte Form füllen." },
    { "component": "Aufbau", "text": "Die gefrorene Torteneinlage aus der Tortaflexform lösen und mit der Madeleineteigseite nach unten in die Mousse drücken." },
    { "component": "Aufbau", "text": "Mit der restlichen Mousse bedecken." },
    { "component": "Aufbau", "text": "Den Pistazienknusperboden auflegen." },
    { "component": "Aufbau", "text": "Mit Frischhaltefolie bedeckt mindestens eine Nacht einfrieren." },

    { "component": "Transparente Glanzglasur", "text": "Die Gelatine in eiskaltem Wasser einweichen." },
    { "component": "Transparente Glanzglasur", "text": "Alle restlichen Zutaten zusammen aufkochen." },
    { "component": "Transparente Glanzglasur", "text": "Kurz leise köcheln lassen, bis der Zucker gelöst ist." },
    { "component": "Transparente Glanzglasur", "text": "Vom Herd nehmen." },
    { "component": "Transparente Glanzglasur", "text": "Die ausgedrückte Gelatine auflösen." },
    { "component": "Transparente Glanzglasur", "text": "Mit Folie bedeckt über Nacht im Kühlschrank erstarren lassen." },

    { "component": "Vanille Namelaka (optional)", "text": "Die Gelatine einweichen." },
    { "component": "Vanille Namelaka (optional)", "text": "Die Kuvertüre schmelzen." },
    { "component": "Vanille Namelaka (optional)", "text": "Milch und Vanille aufkochen." },
    { "component": "Vanille Namelaka (optional)", "text": "Die ausgedrückte Gelatine darin auflösen." },
    { "component": "Vanille Namelaka (optional)", "text": "Alles zur Kuvertüre geben." },
    { "component": "Vanille Namelaka (optional)", "text": "Mit dem Stabmixer durchmixen und dabei die kalte Sahne hinzufließen lassen." },
    { "component": "Vanille Namelaka (optional)", "text": "In ein flaches Gefäß füllen und die Oberfläche mit Frischhaltefolie bedecken." },
    { "component": "Vanille Namelaka (optional)", "text": "Mindestens 6 Stunden, besser über Nacht, in den Kühlschrank stellen." },
    { "component": "Vanille Namelaka (optional)", "text": "Wie Schlagsahne aufschlagen und in einen Spritzbeutel füllen." },

    { "component": "Fertigstellung", "text": "Die transparente Glasur vorsichtig auf 28–32 °C erwärmen." },
    { "component": "Fertigstellung", "text": "Die gefrorene Torte aus der Form lösen." },
    { "component": "Fertigstellung", "text": "Erhöht auf eine Schale stellen, die die überlaufende Glasur auffängt." },
    { "component": "Fertigstellung", "text": "Eventuellen Reif von der Oberfläche entfernen." },
    { "component": "Fertigstellung", "text": "Gleichmäßig mit der Glasur übergießen." },
    { "component": "Fertigstellung", "text": "Beim Anziehen der Glasur die Tropfen am unteren Rand abstreifen." },
    { "component": "Fertigstellung", "text": "Die Torte auf einen Teller oder Tortenkarton setzen und auftauen lassen." },
    { "component": "Fertigstellung", "text": "Optional die Vanille Namelaka mit einer großen Lochtülle dressieren." },
    { "component": "Fertigstellung", "text": "Mit frischen roten und schwarzen Johannisbeeren und Blattgold garnieren." }
  ],
