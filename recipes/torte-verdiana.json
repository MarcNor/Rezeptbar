  "steps": [
    { "component": "Grapefruitkompott mit Himbeere", "text": "Die Gelatine in eiskaltem Wasser einweichen." },
    { "component": "Grapefruitkompott mit Himbeere", "text": "Den Zucker mit dem Pektin vermischen." },
    { "component": "Grapefruitkompott mit Himbeere", "text": "Die Grapefruit schälen und die Filets ausnehmen – sie müssen ganz frei von weißer Haut sein." },
    { "component": "Grapefruitkompott mit Himbeere", "text": "Die Filets mit Himbeerpüree und Limettensaft pürieren." },
    { "component": "Grapefruitkompott mit Himbeere", "text": "Den Timutpfeffer mörsern und durchsieben." },
    { "component": "Grapefruitkompott mit Himbeere", "text": "Das Fruchtpüree mit dem Timutpfeffer leicht erhitzen." },
    { "component": "Grapefruitkompott mit Himbeere", "text": "Die Zucker-Pektin-Mischung zugeben." },
    { "component": "Grapefruitkompott mit Himbeere", "text": "Etwa 2 Minuten kochen lassen." },
    { "component": "Grapefruitkompott mit Himbeere", "text": "Vom Herd nehmen und die ausgedrückte Gelatine auflösen." },
    { "component": "Grapefruitkompott mit Himbeere", "text": "Mit Folie bedecken und ca. 30 Minuten gelieren lassen." },

    { "component": "Gepresster Erdnussboden", "text": "Alle Zutaten gut vermischen." },
    { "component": "Gepresster Erdnussboden", "text": "Die Masse in die Tortaflex-Form geben." },
    { "component": "Gepresster Erdnussboden", "text": "Mit der Unterseite eines Glases fest andrücken." },

    { "component": "Limettenbiskuit", "text": "Den Ofen auf 180 °C vorheizen." },
    { "component": "Limettenbiskuit", "text": "Das Eigelb mit Zucker A und den gemahlenen Mandeln verschlagen." },
    { "component": "Limettenbiskuit", "text": "Das Eiweiß mit Zucker B zu festem Eischnee schlagen." },
    { "component": "Limettenbiskuit", "text": "Den Eischnee in drei Portionen unter die Eigelbmasse ziehen." },
    { "component": "Limettenbiskuit", "text": "Das Mehl übersieben." },
    { "component": "Limettenbiskuit", "text": "Mit Limettenabrieb und Butter sanft verarbeiten." },
    { "component": "Limettenbiskuit", "text": "Die Masse als Kreis mit 18 cm ∅ auf Backpapier verstreichen." },
    { "component": "Limettenbiskuit", "text": "Etwa 10 Minuten backen." },
    { "component": "Limettenbiskuit", "text": "Noch warm einen Kreis mit 16 cm ∅ ausstechen." },
    { "component": "Limettenbiskuit", "text": "Den Biskuit sofort auf den Erdnussboden legen." },

    { "component": "Tränke", "text": "Grapefruitsaft mit Agavendicksaft verrühren." },
    { "component": "Tränke", "text": "Den Biskuit damit bestreichen." },

    { "component": "Himbeerganache", "text": "Die Gelatine in eiskaltem Wasser einweichen." },
    { "component": "Himbeerganache", "text": "Die Kuvertüre schmelzen." },
    { "component": "Himbeerganache", "text": "Das Himbeerpüree mit dem Limettensaft aufkochen." },
    { "component": "Himbeerganache", "text": "Die Gelatine darin auflösen." },
    { "component": "Himbeerganache", "text": "Alles in die Kuvertüre rühren." },
    { "component": "Himbeerganache", "text": "Mit dem Stabmixer pürieren und die kalte Sahne zugeben, gut durchmixen." },
    { "component": "Himbeerganache", "text": "Die Ganache auf dem angefrorenen Grapefruitkompott verteilen." },
    { "component": "Himbeerganache", "text": "Die Tortaflex-Form einfrieren, bis alles fest ist." },

    { "component": "Ricottamousse mit Minze und Limette", "text": "Die Gelatine in eiskaltem Wasser einweichen." },
    { "component": "Ricottamousse mit Minze und Limette", "text": "Die Milch mit dem Limettenabrieb aufkochen." },
    { "component": "Ricottamousse mit Minze und Limette", "text": "Die Eigelbe mit dem Zucker verrühren." },
    { "component": "Ricottamousse mit Minze und Limette", "text": "Die heiße Milch in die Eigelbmasse rühren und zurück in den Topf geben." },
    { "component": "Ricottamousse mit Minze und Limette", "text": "Bei mittlerer Hitze unter ständigem Rühren auf 83 °C erhitzen." },
    { "component": "Ricottamousse mit Minze und Limette", "text": "Vom Herd nehmen und die ausgedrückte Gelatine auflösen." },
    { "component": "Ricottamousse mit Minze und Limette", "text": "Ricotta mit Agavendicksaft, Limettensaft und Minze in ein hohes Gefäß geben." },
    { "component": "Ricottamousse mit Minze und Limette", "text": "Mit dem Stabmixer durchmixen und die heiße Limettencreme einarbeiten, 1–2 Minuten mixen." },
    { "component": "Ricottamousse mit Minze und Limette", "text": "Abkühlen lassen, bis die Gelierung beginnt." },
    { "component": "Ricottamousse mit Minze und Limette", "text": "Die Sahne halbsteif schlagen und unterheben." },
    { "component": "Ricottamousse mit Minze und Limette", "text": "380 g Mousse in die Universo-Form füllen." },
    { "component": "Ricottamousse mit Minze und Limette", "text": "Die gefrorene Einlage mittig eindrücken." },
    { "component": "Ricottamousse mit Minze und Limette", "text": "Glattstreichen und mit Folie bedeckt mindestens eine Nacht einfrieren." },

    { "component": "Mirror Glaze", "text": "Die Gelatine einweichen." },
    { "component": "Mirror Glaze", "text": "Milch und Sahne mit dem Glucosesirup in einen Topf geben." },
    { "component": "Mirror Glaze", "text": "Den Zucker mit der Maisstärke vermischen und unterrühren." },
    { "component": "Mirror Glaze", "text": "Die Lebensmittelfarbe zugeben." },
    { "component": "Mirror Glaze", "text": "Unter Rühren zum Kochen bringen." },
    { "component": "Mirror Glaze", "text": "Kurz aufwallen lassen, vom Herd nehmen und in ein hohes Gefäß gießen." },
    { "component": "Mirror Glaze", "text": "Die ausgedrückte Gelatine auflösen." },
    { "component": "Mirror Glaze", "text": "Mit dem Stabmixer gut durchpürieren, ohne Luftblasen einzuarbeiten." },
    { "component": "Mirror Glaze", "text": "Mit Folie bedeckt über Nacht kühl stellen." },

    { "component": "Fertigstellung", "text": "Die Mirror Glaze auf 45 °C erwärmen, bis sie flüssig ist." },
    { "component": "Fertigstellung", "text": "Zum Gießen auf 26–32 °C abkühlen lassen – die Glasur soll wie Sahne fließen." },
    { "component": "Fertigstellung", "text": "Die gefrorene Torte ausformen und darauf achten, dass sich kein Reif auf der Oberfläche gebildet hat." },
    { "component": "Fertigstellung", "text": "Die Torte erhöht auf eine flache Schale stellen." },
    { "component": "Fertigstellung", "text": "Gleichmäßig mit der Glasur übergießen." },
    { "component": "Fertigstellung", "text": "Die Tropfen am unteren Rand abstreifen." },
    { "component": "Fertigstellung", "text": "Die Torte auf einen Teller oder Untersetzer setzen." },
    { "component": "Fertigstellung", "text": "Den großen Schokoladenring um die Torte legen." },
    { "component": "Fertigstellung", "text": "Den kleinen Ring mittig auf die Torte setzen." },
    { "component": "Fertigstellung", "text": "Die Torte ca. 4–6 Stunden auftauen lassen." },
    { "component": "Fertigstellung", "text": "Die Schlagsahne mit dem Puderzucker anschlagen und 50 g Ricottamousse einarbeiten." },
    { "component": "Fertigstellung", "text": "In einen Spritzbeutel mit 14 mm Rundtülle füllen." },
    { "component": "Fertigstellung", "text": "Tupfen in den inneren Schokoladenring dressieren." },
    { "component": "Fertigstellung", "text": "Mit Grapefruitfiletstückchen, Himbeeren, Minzblättchen und essbarem Gold garnieren." }
  ],
  "notes": ""
