  "steps": [
    { "component": "Boden", "text": "Eier, Zucker, Salz und Vanilleextrakt 5–6 Minuten cremig rühren." },
    { "component": "Boden", "text": "Den heißen Espresso über Schokolade und Butter gießen und schmelzen lassen." },
    { "component": "Boden", "text": "Die Schokoladenmasse in die Eiermasse einrühren." },
    { "component": "Boden", "text": "Mehl und Kakao sieben, die Tonkabohne darüberreiben und alles unterheben." },
    { "component": "Boden", "text": "In den 20-cm-Backring füllen und bei 170 °C Ober-/Unterhitze ca. 25 Minuten backen." },
    { "component": "Boden", "text": "Aus der Form nehmen, stürzen und vollständig abkühlen lassen." },
    { "component": "Boden", "text": "Einen sauberen Tortenring außen herum legen." },

    { "component": "Creme (Basis)", "text": "Die Sahne mit San-apart steif schlagen." },
    { "component": "Creme (Basis)", "text": "Quark, Puderzucker und Vanilleextrakt verrühren und die Sahne unterheben." },
    { "component": "Creme (Basis)", "text": "400 g für die helle Schicht beiseitestellen, den Rest halbieren." },

    { "component": "Schokoladencreme", "text": "Wasser und Agar Agar aufkochen und 2 Minuten sprudelnd kochen lassen." },
    { "component": "Schokoladencreme", "text": "Die Schokolade schmelzen und mit der Agar-Mischung verrühren." },
    { "component": "Schokoladencreme", "text": "2–3 EL der ersten Cremeportion einrühren, dann alles unter die restliche Creme heben." },
    { "component": "Schokoladencreme", "text": "Über dem Tortenboden verstreichen und 30 Minuten kühl stellen." },

    { "component": "Brombeercreme", "text": "Die aufgetauten Brombeeren mit dem Wasser pürieren." },
    { "component": "Brombeercreme", "text": "Mit Agar Agar aufkochen und 2 Minuten sprudelnd kochen lassen." },
    { "component": "Brombeercreme", "text": "2–3 Minuten lauwarm abkühlen lassen." },
    { "component": "Brombeercreme", "text": "2–3 EL der zweiten Cremeportion einrühren, dann die gesamte Creme unterheben." },
    { "component": "Brombeercreme", "text": "Über der Schokoladencreme verstreichen und 30 Minuten kühl stellen." },

    { "component": "Helle Creme", "text": "Wasser und Agar Agar 2 Minuten kochen." },
    { "component": "Helle Creme", "text": "2–3 EL der großen Cremeportion einrühren, dann die Agar-Mischung unterheben." },
    { "component": "Helle Creme", "text": "Über der Brombeercreme verstreichen und 15 Minuten kühl stellen." },

    { "component": "Brombeergelee", "text": "Die aufgetauten Brombeeren mit dem Wasser pürieren und mit Agar Agar verrühren." },
    { "component": "Brombeergelee", "text": "2 Minuten sprudelnd kochen." },
    { "component": "Brombeergelee", "text": "Lauwarm abkühlen lassen und über die Torte gießen." },
    { "component": "Brombeergelee", "text": "Mindestens 3 Stunden oder über Nacht kühl stellen." },

    { "component": "Tupfen", "text": "Die Brombeeren einkochen, bis fast die gesamte Flüssigkeit verdunstet ist." },
    { "component": "Tupfen", "text": "Durch ein Haarsieb streichen und abkühlen lassen." },
    { "component": "Tupfen", "text": "Mit Frischkäse, Sahne, Puderzucker und San-apart verrühren und steif schlagen." },
    { "component": "Tupfen", "text": "In einen Spritzbeutel mit gezackter Sterntülle füllen und Tupfen auf die Torte spritzen." },
    { "component": "Tupfen", "text": "Mit Brombeeren und Minzblättern dekorieren." }
  ],
  "notes": ""
}
