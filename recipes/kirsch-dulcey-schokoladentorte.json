  "steps": [
    { "component": "Kirschkompottschicht", "text": "Die Gelatine in eiskaltem Wasser einweichen." },
    { "component": "Kirschkompottschicht", "text": "Die Sauerkirschen grob pürieren und mit dem Zucker aufkochen." },
    { "component": "Kirschkompottschicht", "text": "Abkühlen lassen und die Gelatine in der Fruchtmasse auflösen." },
    { "component": "Kirschkompottschicht", "text": "In die Tortaflex-Form füllen und 1–2 Stunden einfrieren." },

    { "component": "Praliné Mousse", "text": "Die Gelatine in eiskaltem Wasser einweichen." },
    { "component": "Praliné Mousse", "text": "Die flüssige Sahne erhitzen." },
    { "component": "Praliné Mousse", "text": "Eigelb mit Zucker verrühren." },
    { "component": "Praliné Mousse", "text": "Die heiße Sahne unter Rühren in die Eigelbmasse gießen." },
    { "component": "Praliné Mousse", "text": "Zurück in den Topf geben und bei mittlerer Hitze auf ca. 82 °C erhitzen." },
    { "component": "Praliné Mousse", "text": "Die Gelatine auflösen und die Masse über die Kuvertüre gießen." },
    { "component": "Praliné Mousse", "text": "Mit der Pralinémasse glattrühren." },
    { "component": "Praliné Mousse", "text": "Die Sahne cremig schlagen und unterheben." },
    { "component": "Praliné Mousse", "text": "Auf die gefrorene Kirschschicht gießen und abgedeckt einfrieren." },

    { "component": "Sacherbiskuit", "text": "Den Backofen auf 180 °C Ober-/Unterhitze vorheizen." },
    { "component": "Sacherbiskuit", "text": "Die Springform auslegen." },
    { "component": "Sacherbiskuit", "text": "Kuvertüre und Butter im Wasserbad schmelzen und abkühlen lassen." },
    { "component": "Sacherbiskuit", "text": "Eigelb, Nüsse und Zucker hellschaumig aufschlagen." },
    { "component": "Sacherbiskuit", "text": "Die Schokoladen-Butter-Mischung unterrühren." },
    { "component": "Sacherbiskuit", "text": "Das Eiweiß mit dem Puderzucker zu festem Eischnee schlagen." },
    { "component": "Sacherbiskuit", "text": "Die Hälfte des Eischnees unterheben, die zweite Hälfte auf den Teig geben." },
    { "component": "Sacherbiskuit", "text": "Mehl und Kakao darübersieben und locker unterheben." },
    { "component": "Sacherbiskuit", "text": "In die Form füllen und ca. 15 Minuten backen." },

    { "component": "Knusperschicht", "text": "Praliné, Butter und weiße Schokolade im Wasserbad schmelzen." },
    { "component": "Knusperschicht", "text": "Mit den zerkleinerten Waffeln und den gehackten Nüssen vermengen." },
    { "component": "Knusperschicht", "text": "Auf dem leicht abgekühlten Biskuit verstreichen." },
    { "component": "Knusperschicht", "text": "In den Kühlschrank stellen." },
    { "component": "Knusperschicht", "text": "Mit 16 cm ∅ ausstechen." },

    { "component": "Dulcey-Schokoladenmousse", "text": "Die Vollmilch mit der Vanille erhitzen." },
    { "component": "Dulcey-Schokoladenmousse", "text": "Die Eigelbe mit dem Zucker verschlagen." },
    { "component": "Dulcey-Schokoladenmousse", "text": "Die heiße Vanillemilch in die Eigelbmasse gießen." },
    { "component": "Dulcey-Schokoladenmousse", "text": "Zurück in den Topf geben und bei mittlerer Hitze auf ca. 83 °C erhitzen." },
    { "component": "Dulcey-Schokoladenmousse", "text": "Die Gelatine auflösen und die Masse über die gehackte Dulcey gießen." },
    { "component": "Dulcey-Schokoladenmousse", "text": "Mit dem Stabmixer durchpürieren und auf 35 °C abkühlen lassen." },
    { "component": "Dulcey-Schokoladenmousse", "text": "Die Sahne cremig aufschlagen und unterheben." },

    { "component": "Aufbau", "text": "Drei Viertel der Dulcey-Mousse in die Universo-Form füllen." },
    { "component": "Aufbau", "text": "Die eingefrorene Kirsch-Praliné-Schicht eindrücken." },
    { "component": "Aufbau", "text": "Etwas Dulcey-Mousse darauf verteilen." },
    { "component": "Aufbau", "text": "Den auf 16 cm ausgestochenen Sacherbiskuit einfügen." },
    { "component": "Aufbau", "text": "Die Ränder auffüllen und glattstreichen." },
    { "component": "Aufbau", "text": "Über Nacht einfrieren." },

    { "component": "Schokoladenguss", "text": "Zucker, Wasser und Glucosesirup auf 103 °C erhitzen." },
    { "component": "Schokoladenguss", "text": "Vom Herd nehmen und die Kondensmilch einrühren." },
    { "component": "Schokoladenguss", "text": "Die Gelatine auflösen." },
    { "component": "Schokoladenguss", "text": "Über die gehackte Kuvertüre gießen." },
    { "component": "Schokoladenguss", "text": "Eine Minute stehen lassen." },
    { "component": "Schokoladenguss", "text": "Mit dem Mixstab emulgieren, ohne Luftblasen einzuarbeiten." },

    { "component": "Fertigstellung", "text": "Die Torte aus der Form lösen." },
    { "component": "Fertigstellung", "text": "Eine Hälfte mit braunem Velvetspray besprühen." },
    { "component": "Fertigstellung", "text": "Die andere Hälfte mit dem 35 °C warmen Schokoladenguss bedecken." },
    { "component": "Fertigstellung", "text": "Mit essbarem Gold, Kirschen und Schokoladendekor garnieren." }
  ],
  "notes": ""
}
