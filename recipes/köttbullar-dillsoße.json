  "steps": [
    { "component": "Köttbullar", "text": "Das Kichererbsenmehl gründlich mit der Sojasahne verrühren."},
    { "component": "Köttbullar", "text": "Anschließend auch das Paniermehl, Salz, Pfeffer und Steaksalz einrühren und 10 Minuten ziehen lassen."},
    { "component": "Köttbullar", "text": "Währenddessen das trockene Sojagranulat mit dem Seitan-Fix vermengen."},
    { "component": "Köttbullar", "text": "Etwas Öl in einer Pfanne erhitzen und die Zwiebel darin glasig braten. Anschließend weitestgehend abkühlen lassen."},
    { "component": "Köttbullar", "text": "Die Zwiebel, Ketchup, Tomatenmark und BBQ-Sauce in das Paniermehlgemisch rühren."},
    { "component": "Köttbullar", "text": "Mit dem Seitan-Sojagranulat-Mix zu einem Teig verkneten."},
    { "component": "Köttbullar", "text": "Evtl. noch etwas mehr Paniermehl oder Wasser dazu geben, die rohen veganen Köttbullar sollten sich gut formen lassen."},
    { "component": "Köttbullar", "text": "5 Minuten quellen lassen. Dann das Kokosöl einkneten."},
    { "component": "Köttbullar", "text": "Den Teig zu kleinen Kugeln oder flachen Frikadellen formen."},
    { "component": "Köttbullar", "text": "Öl in einer Pfanne erhitzen und die Köttbullar darin langsam rundum knusprig braten. Dafür sollte die Pfanne nicht zu heiß sein."},

    { "component": "Dillsauce", "text": "Die Butter in einem Topf erhitzen."},
    { "component": "Dillsauce", "text": "Mit einem Schneebesen mit dem Mehl und dem Zucker verrühren. So lange rühen, bis sich eine schön schäumende Mehlschwitze ergibt."},
    { "component": "Dillsauce", "text": "Die Milch und die Sahne einrühren."},
    { "component": "Dillsauce", "text": "Aufkochen und köcheln lassen bis eine gute Soßen-Konsistenz erreicht ist."},
    { "component": "Dillsauce", "text": "Den Dill dazu geben und das Ganze mit Zitronensaft, Salz, Pfeffer (eher sparsam) und Muskat abschmecken."}
  ],
