  "steps": [
    { "component": "Crispy Schicht", "text": "Die weiße Kuvertüre schmelzen und mit dem Praliné verrühren." },
    { "component": "Crispy Schicht", "text": "Shortbread und Crêpes dentelles zerbröseln." },
    { "component": "Crispy Schicht", "text": "Alle Zutaten vermengen." },
    { "component": "Crispy Schicht", "text": "Zwischen Backpapier 3–4 mm dick ausrollen, mindestens 18 × 18 cm groß." },
    { "component": "Crispy Schicht", "text": "Kurz einfrieren oder in den Kühlschrank legen." },

    { "component": "Himbeerbiskuit", "text": "Den Backofen auf 180 °C Ober-/Unterhitze vorheizen." },
    { "component": "Himbeerbiskuit", "text": "Die Butter schmelzen und abkühlen lassen." },
    { "component": "Himbeerbiskuit", "text": "Vollei, Mandeln und Puderzucker schaumig rühren." },
    { "component": "Himbeerbiskuit", "text": "Das Eiweiß steif schlagen." },
    { "component": "Himbeerbiskuit", "text": "Ein Drittel des Eischnees untermischen, dann den Rest unterheben." },
    { "component": "Himbeerbiskuit", "text": "Das Mehl darübersieben und die geschmolzene Butter einarbeiten." },
    { "component": "Himbeerbiskuit", "text": "Die Masse ca. 40 × 22 cm auf ein Backblech mit Backpapier streichen." },
    { "component": "Himbeerbiskuit", "text": "Die gefrorenen Himbeeren zerbröseln und darauf verteilen." },
    { "component": "Himbeerbiskuit", "text": "Ca. 15–17 Minuten backen." },
    { "component": "Himbeerbiskuit", "text": "Abkühlen lassen." },
    { "component": "Himbeerbiskuit", "text": "Zwei Quadrate von 18 × 18 cm mit dem Backrahmen ausstechen." },

    { "component": "Himbeer Crèmeux", "text": "Die Gelatine einweichen." },
    { "component": "Himbeer Crèmeux", "text": "Himbeerpüree, Zitronensaft und Zucker im Topf verrühren." },
    { "component": "Himbeer Crèmeux", "text": "Eigelb und Vollei zugeben." },
    { "component": "Himbeer Crèmeux", "text": "Vorsichtig auf maximal 85 °C erhitzen." },
    { "component": "Himbeer Crèmeux", "text": "Vom Herd ziehen und die Gelatine unterrühren." },
    { "component": "Himbeer Crèmeux", "text": "Rosenwasser und Himbeerpulver zugeben." },
    { "component": "Himbeer Crèmeux", "text": "Mit dem Stabmixer durchpürieren." },
    { "component": "Himbeer Crèmeux", "text": "Die Butter schrittweise untermixen." },

    { "component": "Aufbau", "text": "Die Crispy-Schicht mit dem Backrahmen ausstechen und den Rahmen darum stehen lassen." },
    { "component": "Aufbau", "text": "Dünn mit Himbeerkonfitüre bestreichen." },
    { "component": "Aufbau", "text": "Die erste Himbeerbiskuit-Schicht mit den Himbeeren nach oben auflegen." },
    { "component": "Aufbau", "text": "Den Himbeer Crèmeux einfüllen und glattstreichen." },
    { "component": "Aufbau", "text": "Die zweite Biskuit-Schicht mit der Himbeerseite nach unten auflegen." },

    { "component": "Mango-Lassi Mousse", "text": "Die Gelatine einweichen." },
    { "component": "Mango-Lassi Mousse", "text": "Die Fruchtpürees mit Eigelb und Zucker wie beim Crèmeux auf maximal 85 °C erhitzen." },
    { "component": "Mango-Lassi Mousse", "text": "Die Gelatine auflösen." },
    { "component": "Mango-Lassi Mousse", "text": "Den Joghurt mit dem Stabmixer einarbeiten." },
    { "component": "Mango-Lassi Mousse", "text": "Die Sahne halbsteif schlagen und unter die Fruchtmasse ziehen." },
    { "component": "Mango-Lassi Mousse", "text": "Auf die Biskuitschicht geben und glattstreichen, dabei ca. 3 mm Platz für den Maracujaspiegel lassen." },
    { "component": "Mango-Lassi Mousse", "text": "Im Kühlschrank erstarren lassen." },

    { "component": "Maracujaspiegel", "text": "Die Gelatine einweichen." },
    { "component": "Maracujaspiegel", "text": "Orangensaft, Maracuja-Fruchtfleisch, Maracujapüree und Zucker aufkochen." },
    { "component": "Maracujaspiegel", "text": "Durch ein Sieb gießen und auf 165 g abwiegen." },
    { "component": "Maracujaspiegel", "text": "Die Gelatine in der Flüssigkeit auflösen." },
    { "component": "Maracujaspiegel", "text": "Nach Wunsch die Maracujasamen wieder zugeben." },
    { "component": "Maracujaspiegel", "text": "Auf Zimmertemperatur abkühlen lassen – keinesfalls heiß gießen, sonst löst sich die Mousse an." },
    { "component": "Maracujaspiegel", "text": "Über die Mangomousse gießen." },
    { "component": "Maracujaspiegel", "text": "Die Torte erneut in den Kühlschrank stellen, bis der Spiegel fest ist." },

    { "component": "Fertigstellung", "text": "Mit einem scharfen Messer eng am Rahmenrand entlangfahren." },
    { "component": "Fertigstellung", "text": "Den Rahmen abheben." },
    { "component": "Fertigstellung", "text": "Die äußeren Kanten mit einem langen Messer abschneiden." },
    { "component": "Fertigstellung", "text": "In die gewünschte Größe schneiden." },
    { "component": "Fertigstellung", "text": "Die Himbeeren in Goldpuder tunken und mit Konfitüre füllen." },
    { "component": "Fertigstellung", "text": "Mit Mangospalten, Schokoladen- und/oder Minzblättern garnieren." }
  ],
  "notes": ""
}
